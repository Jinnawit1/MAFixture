table.TableExcel td.text-center{
    padding: 0px !important;
}
table.TableExcel.MC td {
    border: gray solid 1px !important;
}
table.TableExcel.MC th {
    border: gray solid 1px !important;
}

table.TableExcel.Planning th {
    border: gray dashed 1px !important;
}

table.TableExcel.MC thead :nth-child(n) {
    background-color: rgb(255,255,0);
}

table.TableExcel.MC thead :nth-child(n + 4) {
    background-color: rgb(242,220,219); color: blue;
}

table.TableExcel.MC thead :nth-child(6) {
    background-color: rgb(146,208,80); color: blue;
}

table.TableExcel.MC thead :nth-child(7) {
    background-color: rgb(242,220,219); color: blue;
}

table.TableExcel.MC thead :nth-child(8) {
    background-color: rgb(146,208,80); color: blue;
}

table.TableExcel.MC thead :nth-child(9) {
    background-color: rgb(235,241,222); color: blue;
}

table.TableExcel.MC thead :nth-child(10) {
    background-color: rgb(255,255,0); color: blue;
}

table.TableExcel.Planning thead :nth-child(n) {
    background-color: rgb(0,176,240);
}

table.TableExcel.Planning thead :nth-child(n + 10) {
    background-color: rgb(255,255,0);
}

table.TableExcel.Planning thead :nth-child(12) {
    background-color: rgb(0,176,240);
}

table.TableExcel.Planning thead :nth-child(2n + 13) {
    background-color: rgb(146,208,80); color: blue;
}

table.TableExcel.Planning thead :nth-child(2n + 14) {
    background-color: rgb(216,228,188); color: blue;
}

table.TableExcel.SaleExp thead :nth-child(n + 12) {
    background-color: rgb(146,208,80);
}

table.TableExcel.SaleExp thead :nth-child(17) {
    background-color: white;
}

table.TableExcel.SaleExp thead :nth-child(n + 18) {
    background-color: rgb(255,192,0);
}

table.TableExcel.SaleExp tbody {
    line-height: 1 !important;
}

.table > thead > tr > th {
    vertical-align: middle; padding-left: 10px;
}
.table > tbody > tr > td {
    vertical-align: middle;
}
