@font-face {
  font-family: 'Poppins';
  font-style: normal;
  font-weight: 400;
  src: url('../fonts/poppins-v8-latin-regular.eot'); /* IE9 Compat Modes */
  src: local('Poppins Regular'), local('Poppins-Regular'),
       url('../fonts/poppins-v8-latin-regular.eot?#iefix') format('embedded-opentype'), /* IE6-IE8 */
       /*url('../fonts/poppins-v8-latin-regular.woff2') format('woff2'),  Super Modern Browsers
       url('../fonts/poppins-v8-latin-regular.woff') format('woff'),  Modern Browsers */
       url('../fonts/poppins-v8-latin-regular.ttf') format('truetype'), /* Safari, Android, iOS */
       url('../fonts/poppins-v8-latin-regular.svg#Poppins') format('svg'); /* Legacy iOS */
}
.Color {
    font-weight: 900;
    cursor:wait;
}
.Color.Red{
    color: #fc0314;
}
.Color.Green{
    color: #9bbb59;
}
.Color:hover{
    font-size:120%;
}
/* unvisited link */
a:link {
    color: white;
}

/* visited link */
a:visited {
    color: white;
}

/* mouse over link */
a:hover {
    color: white;
}

/* selected link */
a:active {
    color: white;
}

nav {
    width: 100%;
    height: 30px;
    font-family: Calibri;
}
.nav a {
    font-size: 1.6em !important;
}

/*.navbar-collapse {
    padding-left: 5px !important;
    padding-right: 5px !important;
}*/
.nav > li > a {
    padding-left: 10px !important;
    padding-right: 10px !important;
}

.nav-tabs > li > a {
    border: 0px !important;
    border-radius: 0px !important;
    border-right: 1px solid lightgray !important;
    margin-right: 0px !important;
}
.nav-tabs > li.active a {
    color: rgb(33,115,70) !important;
    box-shadow: inset 0 -4px rgb(33,115,70) !important;
}

.nav-tabs > li > a:hover, a:focus {
    text-shadow:0px 0px 1px black !important;
    color: black !important;
}


/* ---------------Set color navbar active */
.nav.navbar-nav > li a{   
  color : rgba(17, 17, 17, 1);
}
.nav.navbar-nav > li a:hover{   
  color: red;
  background-color: #555555;
}
.nav.navbar-nav > li.active a{   
  background-color: rgba(163, 231, 255, 1);
  color: blue;
  border-left: 1px solid lightgray;
  border-right: 1px solid lightgray;
}

/*.navbar-fixed-top, .navbar-fixed-bottom {
    position: fixed !important;
}*/

.modal {
  text-align: center;
  padding: 0!important;
  overflow: auto !important;
}

.modal:before {
  content: '';
  display: inline-block;
  height: 100%;
  vertical-align: middle;
  margin-right: -4px;
}

.modal-dialog {
  display: inline-block;
  text-align: left;
  vertical-align: middle;
}

body {
    font-family: 'Poppins', sans-serif;
    background-color: white;
    /*background: #fafafa;*/
}
p {
    font-family: 'Poppins', sans-serif;
    font-size: 1.1em;
    font-weight: 300;
    line-height: 1.7em;
    color: #999;
}

a,
a:hover,
a:focus {
    color: inherit;
    text-decoration: none;
    transition: all 0.3s;
}

.dt-buttons {
    padding-left:50px;
}
.dt-buttons a:link {
    color : rgba(51, 122, 183, 1);
}

.lineStrong {
    width: 100%;
    height: 1px;
    border-bottom: 1px double #000000;
    margin: 40px 0;
}

.line {
    width: 100%;
    height: 1px;
    border-bottom: 1px dashed #ddd;
    margin: 5px 0;
}

.PointerHoverRed {
   cursor: pointer;
}
.PointerHoverRed:hover { 
   color: red;
} 
.PointerHoverBlue {
   cursor: pointer;
}
.PointerHoverBlue:hover { 
   color: blue;
}
.PointerHoverGreen {
   cursor: pointer;
}
.PointerHoverGreen:hover { 
   color: green;
} 
.PointerHoverYellow {
   cursor: pointer;
}
.PointerHoverYellow:hover { 
   color: yellow;
} 

@media (min-width: 680px) {
   .jsSticky {
      height: 60px;
      background: firebrick;
      position: relative;
   }
   
   .sticky {
      position: fixed;
      top: 0;
   }
}

@supports (position: sticky) or (position: -webkit-sticky) {
   @media (min-width: 680px) {
      .jsSticky {
         position: -webkit-sticky;
         position: sticky;
         top: 0;
         background: plum;
      }
   }
}
.dataTables_length {
    margin-bottom:10px;
}
.dataTables_filter {
    margin-bottom:10px
}

table tbody{
    word-wrap: break-word;
}

table.dataTable tbody > tr.selected, table.dataTable tbody > tr > .selected
