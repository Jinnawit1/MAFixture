
@{
    ViewBag.Title = "Summary Tools";
}

<style>
    /* Status-Aware Badges for Summary Metrics */
    .summary-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 12.5px;
        font-weight: 600;
        text-decoration: none !important;
        transition: all 0.2s ease-in-out;
        min-width: 68px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        line-height: 1.4;
    }
    .summary-badge:hover {
        transform: translateY(-1px);
        box-shadow: 0 3px 6px rgba(0, 0, 0, 0.08);
        text-decoration: none !important;
    }

    /* Normal / Match: Soft Green */
    .badge-status-match {
        background-color: #f6ffed;
        color: #389e0d;
        border: 1px solid #b7eb8f;
    }
    .badge-status-match:hover {
        background-color: #d9f7be;
        color: #237804;
        border-color: #95de64;
    }

    /* Shortage / Under: Soft Warning Orange */
    .badge-status-warning {
        background-color: #fffbe6;
        color: #d46b08;
        border: 1px solid #ffe58f;
    }
    .badge-status-warning:hover {
        background-color: #fff1b8;
        color: #ad4e00;
        border-color: #ffd666;
    }

    /* Excess / Over: Soft Danger Red */
    .badge-status-danger {
        background-color: #fff2f0;
        color: #cf1322;
        border: 1px solid #ffa39e;
    }
    .badge-status-danger:hover {
        background-color: #ffccc7;
        color: #a8071a;
        border-color: #ff7875;
    }

    /* Master Reference: Soft Corporate Blue */
    .badge-master {
        background-color: #e6f4ff;
        color: #0958d9;
        border: 1px solid #91caff;
    }
    .badge-master:hover {
        background-color: #bae0ff;
        color: #003eb3;
        border-color: #69b1ff;
    }

    /* Cycle Time: Soft Slate Neutral */
    .badge-cycletime {
        background-color: #f8fafc;
        color: #334155;
        border: 1px solid #cbd5e1;
        min-width: 74px;
    }
    .badge-cycletime:hover {
        background-color: #f1f5f9;
        color: #0f172a;
        border-color: #94a3b8;
    }
</style>

<h3>Summary Tools</h3>
<hr />

<div class="filter-card">
    <div class="filter-card-header">
        <div>
            <i class="fas fa-filter" style="color: #1890ff; margin-right: 6px;"></i> Search Filters
        </div>
    </div>
    <div class="filter-card-body">
        <div class="row">
            <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="Product_name">Product Name :</label>
                    <input type="text" class="form-control" id="Product_name" placeholder="Search Product name..." onkeydown="if (event.keyCode === 13) { OnLoad(); }">
                </div>
            </div>
            <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="Section">Section :</label>
                    <select class="form-control" id="Section" onchange="OnLoad()">
                        <option value="" selected>All</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="Type">Type :</label>
                    <select class="form-control" id="Type" onchange="OnLoad()">
                        <option value="" selected>All</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="filter-card-footer">
        <button type="button" class="btn-filter-reset" onclick="OnReset()"><i class="fas fa-undo"></i> Reset</button>
        <button type="button" class="btn-filter-search" id="search-button" onclick="OnLoad()"><i class="fas fa-search"></i> Search</button>
    </div>
</div>



<div class="row">
    <div class="col-12 mb-3" style="padding: 3px 0px;">
        <div id="TableForm" style="padding-top: 20px; width: 100%; font-size: 12px !important;">
            @*<table id="TableSP" class="table table-bordered table-hover" style="width: 100%; border-collapse: collapse !important; font-size: 11px !important; table-layout: fixed; "></table>*@
            <table id="TableMAPlan" class="table table-bordered table-hover" style="width: 100% !important; border-collapse: collapse !important; font-size: 13px !important;"></table>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        LoadAll();
    });

    function OnReset() {
        $('#Product_name').val('');
        $('#Section').val('');
        $('#Type').val('');
        OnLoad();
    }
    function getUrlParameter(name) {
        var regex = new RegExp('[?&]' + name + '=([^&#]*)', 'i');
        var results = regex.exec(window.location.search);
        return results ? decodeURIComponent(results[1].replace(/\+/g, ' ')) : '';
    }

    function LoadAll() {
        var url = '@Url.Action("Load_Common_Filters", "Global")';

        $.ajax({
            type: 'POST',
            url: url,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                if (response.success && response.data) {
                    if (response.data.Department) {
                        $.each(response.data.Department, function (index, item) {
                            if (item && item.Section) {
                                $('#Section').append('<option value="' + item.Section + '">' + item.Section + '</option>');
                            }
                        });
                    }
                    if (response.data.ToolTypes) {
                        $.each(response.data.ToolTypes, function (index, item) {
                            if (item) {
                                $('#Type').append('<option value="' + item + '">' + item + '</option>');
                            }
                        });
                    }

                    var pName = getUrlParameter('Product_name');
                    var pSection = getUrlParameter('Section');
                    var pType = getUrlParameter('Type');

                    if (pName) {
                        $('#Product_name').val(pName);
                    }
                    if (pSection) {
                        $('#Section').val(pSection);
                    } else {
                        $('#Section').val('THT_HM');
                    }
                    if (pType) {
                        $('#Type').val(pType);
                    }

                    OnLoad();
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

     function OnLoad() {
        var Product_name = $('#Product_name').val();
        var Section = $('#Section').val();
        var Type = $('#Type').val();
        var dataSet = [];
        var dataFull = [];
        var url = '@Url.Action("Load_SummaryTHTPallet", "Global")';

        $.ajax({
            type: 'POST',
            url: url,
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({
                Product_name: Product_name,
                Section: Section,
                Type: Type
            }),
            dataType: "json",
            async: true,
            success: function (response) {
                if (response.success && response.data) {
                    var maPlan = response.data;
                    var now = Date.now();

                    $(maPlan).each(function (index, item) {
                        var newItem = [];
                        newItem.push(index + 1);
                        newItem.push(item.Product_name || '');
                        newItem.push(item.Section || '');
                        newItem.push(item.Type || '');
                        newItem.push(item.SummarizeAmount !== null && item.SummarizeAmount !== undefined ? item.SummarizeAmount : 0);
                        newItem.push(item.MasterAmount !== null && item.MasterAmount !== undefined ? item.MasterAmount : 0);
                        newItem.push(item.Cycle_Time !== null && item.Cycle_Time !== undefined ? item.Cycle_Time : '-');
                        dataSet.push(newItem);
                        dataFull.push(item);
                    });

                    if ($.fn.dataTable.isDataTable('#TableMAPlan')) {
                        $('#TableMAPlan').DataTable().clear().destroy();
                    }

                    $('#TableMAPlan').DataTable({
                        order: [[0, "asc"]],
                        aLengthMenu: [[25, 50, 100, -1], [25, 50, 100, "All"]],
                        iDisplayLength: 100,
                        data: dataSet,
                        dom: 'lBrtip',
                        autoWidth: false,
                        scrollX: false,
                        buttons: [
                            {
                                extend: 'excel',
                                autoFilter: true,
                                exportOptions: {
                                    format: {
                                        body: function (data, row, col, node) {
                                            if (data && /<[^>]+>/g.test(data)) {
                                                if (/<br\s*\/?>/i.test(data)) {
                                                    return data.replace(/<br\s*\/?>/gi, ' ');
                                                } else {
                                                    var parser = new DOMParser();
                                                    var doc = parser.parseFromString(data, 'text/html');
                                                    return doc.body.textContent || doc.body.innerText;
                                                }
                                            }
                                            return data;
                                        }
                                    }
                                }
                            }
                        ],
                        columns: [
                            { title: "No.", width: "5%" },
                            {
                                title: "Product Name",
                                className: "product-col",
                                width: "25%"
                            },
                            {
                                title: "Section",
                                width: "15%"
                            },
                            {
                                title: "Type",
                                width: "15%"
                            },
                            {
                                title: "Summarize Amount",
                                width: "15%",
                                className: "text-center",
                                render: function (data, type, row) {
                                    if (type === 'display') {
                                        var pName = encodeURIComponent(row[1] || '');
                                        var pSection = encodeURIComponent(row[2] || '');
                                        var url = '@Url.Action("Index", "Global")' + '?Product_name=' + pName + '&Section=' + pSection + '&Type_MA=2';
                                        var sumVal = (data !== null && data !== undefined) ? parseInt(data, 10) : 0;
                                        if (isNaN(sumVal)) { sumVal = 0; }
                                        var mstVal = (row[5] !== null && row[5] !== undefined) ? parseInt(row[5], 10) : 0;
                                        if (isNaN(mstVal)) { mstVal = 0; }

                                        var badgeClass = 'badge-status-match';
                                        var iconHtml = '<i class="fas fa-check-circle" style="font-size: 11px;"></i> ';
                                        var tooltip = 'Normal (Matches Master: ' + mstVal + ')';

                                        if (sumVal < mstVal) {
                                            badgeClass = 'badge-status-warning';
                                            iconHtml = '<i class="fas fa-exclamation-triangle" style="font-size: 11px;"></i> ';
                                            tooltip = 'Shortage: ' + sumVal + ' / ' + mstVal + ' (Missing ' + (mstVal - sumVal) + ')';
                                        } else if (sumVal > mstVal) {
                                            badgeClass = 'badge-status-danger';
                                            iconHtml = '<i class="fas fa-exclamation-circle" style="font-size: 11px;"></i> ';
                                            tooltip = 'Excess: ' + sumVal + ' / ' + mstVal + ' (Over ' + (sumVal - mstVal) + ')';
                                        }

                                        return '<a href="' + url + '" target="_blank" class="summary-badge ' + badgeClass + '" title="' + tooltip + '">' + iconHtml + sumVal + '</a>';
                                    }
                                    return data;
                                }
                            },
                            {
                                title: "Master Amount",
                                width: "15%",
                                className: "text-center",
                                render: function (data, type, row) {
                                    if (type === 'display') {
                                        var pName = encodeURIComponent(row[1] || '');
                                        var pSection = encodeURIComponent(row[2] || '');
                                        var pType = encodeURIComponent(row[3] || '');
                                        var url = '@Url.Action("MasterToolsList", "Global")' + '?Product_name=' + pName + '&Section=' + pSection + '&Type=' + pType;
                                        var text = (data !== null && data !== undefined) ? data : 0;
                                        return '<a href="' + url + '" target="_blank" class="summary-badge badge-master" title="Open in Master Tools List"><i class="fas fa-database" style="font-size: 11px; opacity: 0.85;"></i> ' + text + '</a>';
                                    }
                                    return data;
                                }
                            },
                            {
                                title: "Cycle Time (s)",
                                width: "10%",
                                className: "text-center",
                                render: function (data, type, row) {
                                    if (type === 'display') {
                                        var pName = encodeURIComponent(row[1] || '');
                                        var pSection = encodeURIComponent(row[2] || '');
                                        var pType = encodeURIComponent(row[3] || '');
                                        var url = '@Url.Action("MasterToolsList", "Global")' + '?Product_name=' + pName + '&Section=' + pSection + '&Type=' + pType;
                                        var hasVal = (data !== null && data !== undefined && data !== '' && data !== '-');
                                        var displayText = hasVal ? (data + ' s') : '-';
                                        var iconHtml = hasVal ? '<i class="far fa-clock" style="font-size: 11px; color: #64748b;"></i> ' : '';
                                        return '<a href="' + url + '" target="_blank" class="summary-badge badge-cycletime" title="Open in Master Tools List">' + iconHtml + displayText + '</a>';
                                    }
                                    return data;
                                }
                            }
                        ],
                        deferRender: true,
                        destroy: true,
                        rowCallback: function (row, data) {
                            $(row).find('td:first').addClass('expandable');
                        }
                    });
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }
</script>
