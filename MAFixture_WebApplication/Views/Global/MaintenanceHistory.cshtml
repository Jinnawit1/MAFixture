    var videoInputDevicesStatus = false;

    $(document).ready(function () {
        if ("@ViewData["MA_ID"]" != "") {
            checkserialByID("@ViewData["MA_ID"]");
        }
    });

    window.onload = function () {
        var selectedDeviceId;
        document.getElementById('video').style.display = "none";
        var codeReader = new ZXing.BrowserMultiFormatReader();

        // List video input devices (cameras)
        codeReader.listVideoInputDevices()
            .then(function (videoInputDevices) {
                var sourceSelect = document.getElementById('sourceSelect');
                selectedDeviceId = videoInputDevices[0].deviceId;

                // Populate the sourceSelect dropdown with available camera devices
                if (videoInputDevices.length >= 1) {
                    videoInputDevicesStatus = true;
                    videoInputDevices.forEach(function (element) {
                        var sourceOption = document.createElement('option');
                        sourceOption.text = element.label;
                        sourceOption.value = element.deviceId;
                        sourceSelect.appendChild(sourceOption);
                    });

                    // Update the selected device when the dropdown changes
                    sourceSelect.onchange = function () {
                        selectedDeviceId = sourceSelect.value;
                        // yok
                        codeReader.reset(); // ปิดกล้องเดิมก่อน
                        toggleCodeReader(codeReader, selectedDeviceId); // เริ่มกล้องใหม่ตามที่เลือก
                    };

                    // Show the source selection dropdown if more than one camera is available
                    var sourceSelectPanel = document.getElementById('sourceSelectPanel');
                    sourceSelectPanel.style.display = 'block';
                }

                // Start scanning when the "Start" button is clicked
                document.getElementById('startButton').addEventListener('click', function () {
                    event.preventDefault();
                    toggleCodeReader(codeReader, selectedDeviceId);
                });

                document.getElementById('sourceSelect').addEventListener('change', function () {
                    videoStatus = true;
                    document.getElementById('startButton').click();
                });

            })
            .catch(function (err) {
                //showAlert('error', err, function () { });
            });
    };

    document.getElementById("Serial_No_Input").addEventListener("keydown", function (event) {
        if (event.key === "Enter") {
            checkSerial(event.target.value);
        }
    });

    $(document).on('click', '.show-images', function () {
        var images = JSON.parse($(this).attr('data-images')); // Get the image data from the button's data attribute
        console.log(images);
        var modalContent = '<div style="display: flex; flex-wrap: wrap; justify-content: flex-start; margin: 20px; max-height: 70vh; overflow-y: auto;">';
        images.forEach(function (fileName) {
            modalContent += '<div style="text-align: center; margin: 5px;">' +
                                '<img src="/MATesting/Uploads/' + fileName.FilesMA_ID + '/' + fileName.Image_Name + '" style="width: 200px; height: auto; border: 1px solid #ddd; border-radius: 4px; cursor: pointer;" class="open-image" data-image="/MATesting/Uploads/' + fileName.FilesMA_ID + '/' + fileName.Image_Name + '" />' +
                            '</div>';
        });
        modalContent += '</div>';

        // Create a simple modal or lightbox
        var modal = '<div class="modal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.7); display: flex; justify-content: center; align-items: center; z-index: 9999;">' +
                        '<div style="background: white; padding: 20px; border-radius: 8px;">' +
                            modalContent +
                            '<button onclick="closeModal()" style="margin-top: 20px;" class="btn btn-filled">Close</button>' +
                        '</div>' +
                     '</div>';

        $('body').append(modal);
    });

    $(document).on('click', '.open-image', function () {
        var imageSrc = $(this).attr('data-image'); // Get the image URL
        window.open(imageSrc, '_blank'); // Open the image in a new tab
    });

    function closeModal() {
        $('.modal').remove(); // Remove the modal when close button is clicked
    }

    function checkserialByID(MA_ID) {
        data = {};
        var form = document.getElementById("update-form");
        form.style.display = "none";
        document.getElementById("Serial_No").textContent = '';
        document.getElementById("Section").textContent = '';
        document.getElementById("LastMA_date").textContent = '';
        document.getElementById("Product_name").textContent = '';
        document.getElementById("Equipment_Name").textContent = '';
        document.getElementById("Type_MC").textContent = '';
        document.getElementById("Customer").textContent = '';
        document.getElementById("Section").textContent = '';
        document.getElementById("Property").textContent = '';
        document.getElementById("Responsible_Name").textContent = '';
        document.getElementById("Description").textContent = '';
        document.getElementById("Model").textContent = '';
        document.getElementById("Referrence_No").textContent = '';
        document.getElementById("Manufacture").textContent = '';

        document.getElementById("Pinnumber").textContent = '';
        document.getElementById("Lifetime").textContent = '';
        document.getElementById("Location").textContent = '';
        document.getElementById("Type_MA").textContent = '';
        document.getElementById("GPVProcess").textContent = '';
        document.getElementById("ProcessSide").textContent = '';
        document.getElementById("WithTopCover").textContent = '';
        document.getElementById("WithControlTooling").textContent = '';
        document.getElementById("Grade_Status").textContent = '';
        document.getElementById("Dimension").textContent = '';
        var url = '@Url.Action("Load_MAFixture_By_ID", "Global")';
        var dataJson = JSON.stringify({ MA_ID: MA_ID })

        $.ajax({
            type: 'POST',
            url: url,
            data: dataJson,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                document.getElementById('video-message').textContent = "Point the camera at the barcode.";
                document.getElementById('video-message').style.backgroundColor = '#fffbe6';
                document.getElementById('video-message').style.borderColor = '#ffe58f';
                if (response.success) {
                    if (response.data) {
                        
                        document.getElementById("Equipment_Name_Select").innerHTML = '';
                        document.getElementById("equipmentNameSelectDiv").style.display = "none";
                        setFixtureInfo(response.data);
                        // Call Load_Customer_By_ID and fetch customer name
                        //fetchCustomerName(response.data.Customer_Name);
                        document.getElementById("Customer").textContent = response.data.Customer_Name;
                    }
                } else {
                    showAlert('error', 'Serial number is not found.', function () { });
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
