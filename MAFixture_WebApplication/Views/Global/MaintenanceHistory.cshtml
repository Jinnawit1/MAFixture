    function checkSerial(Serial_No) {
        data = {};
        var form = document.getElementById("update-form");
        form.style.display = "none";
        document.getElementById("Serial_No").textContent = '';
        document.getElementById("Section").textContent = '';
        document.getElementById("LastMA_date").textContent = '';
        document.getElementById("Product_name").textContent = '';
        document.getElementById("Equipment_Name").textContent = '';
        document.getElementById("Type_MC").textContent = '';
        document.getElementById("Customer").textContent = '';
        document.getElementById("Section").textContent = '';
        document.getElementById("Property").textContent = '';
        document.getElementById("Responsible_Name").textContent = '';
        document.getElementById("Description").textContent = '';
        document.getElementById("Model").textContent = '';
        document.getElementById("Referrence_No").textContent = '';
        document.getElementById("Manufacture").textContent = '';

        document.getElementById("Pinnumber").textContent = '';
        document.getElementById("Lifetime").textContent = '';
        document.getElementById("Location").textContent = '';
        document.getElementById("Type_MA").textContent = '';
        document.getElementById("GPVProcess").textContent = '';
        document.getElementById("ProcessSide").textContent = '';
        document.getElementById("WithTopCover").textContent = '';
        document.getElementById("WithControlTooling").textContent = '';
        document.getElementById("Grade_Status").textContent = '';
        document.getElementById("Dimension").textContent = '';
        var url = '@Url.Action("Load_MAFixture_By_Serial", "Global")';
        var dataJson = JSON.stringify({ Serial_No: Serial_No })

        $.ajax({
            type: 'POST',
            url: url,
            data: dataJson,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                document.getElementById('video-message').textContent = "Point the camera at the barcode.";
                document.getElementById('video-message').style.backgroundColor = '#fffbe6';
                document.getElementById('video-message').style.borderColor = '#ffe58f';
                if (response.success) {
                    if (response.data) {
                        document.getElementById("Equipment_Name_Select").innerHTML = '';
                        document.getElementById("equipmentNameSelectDiv").style.display = "none";
                        if (response.data.length == 1) {
                            setFixtureInfo(response.data[0]);
                            //fetchCustomerName(response.data[0].Customer_Name);
                            document.getElementById("Customer").textContent = response.data[0].Customer_Name;
                        } else {
                            document.getElementById("equipmentNameSelectDiv").style.display = "block";
                            equipmentName = response.data;
                            var defaultOption = document.createElement("option");
                            defaultOption.text = "Select Equipment";  // Placeholder text
                            defaultOption.value = "";  // Empty value, ensuring nothing is selected by default
                            defaultOption.disabled = true;  // Make the default option unselectable
                            defaultOption.selected = true;  // Ensure it's selected by default, but user cannot choose it
                            document.getElementById("Equipment_Name_Select").appendChild(defaultOption);

                            equipmentName.forEach(function (item, index) {
                                var option = document.createElement("option");
                                option.text = item.Equipment_Name;
                                option.value = item.MA_ID;
                                document.getElementById("Equipment_Name_Select").appendChild(option);
                            });

                            document.getElementById("Equipment_Name_Select").addEventListener("change", function (event) {
                                checkserialByID(event.target.value);
                            });
                        }
                    }
                } else {
                    showAlert('error', 'Serial number is not found.', function () { });
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

    function setFixtureInfo(dataInfo) {
        videoStatus = false;
        var form = document.getElementById("update-form");
        document.getElementById('startButton').click();
        data = dataInfo;
        form.style.display = "block";
        document.getElementById("Serial_No").textContent = data.Serial_No;
        document.getElementById("Section").textContent = data.Section;
        document.getElementById("LastMA_date").textContent = formatDate(data.LastMA_date, 2);
        var productName = data.Product_name ? data.Product_name : "";
        var items = productName ? (productName.indexOf(',') > -1 ? productName.split(',') : (productName.indexOf('/') > -1 ? productName.split('/') : [productName])) : [];

        if (items.length > 2) {
            document.getElementById("Product_name").textContent = items.slice(0, 2).join(", ") + " And More";
        } else {
            document.getElementById("Product_name").textContent = productName;
        }
        document.getElementById("Equipment_No").textContent = data.Equipment_No;
        document.getElementById("Equipment_Name").textContent = data.Equipment_Name;
        document.getElementById("Type_MC").textContent = data.Type_MC;
        document.getElementById("Customer").textContent = data.Customer;
        document.getElementById("Section").textContent = data.Section;
        document.getElementById("Property").textContent = data.Property;
        document.getElementById("Responsible_Name").textContent = data.Responsible_Name;
        document.getElementById("Description").textContent = data.Description;
        document.getElementById("Model").textContent = data.Model;
        document.getElementById("Referrence_No").textContent = data.Referrence_No;
        document.getElementById("Manufacture").textContent = data.Manufacture;

        document.getElementById("Pinnumber").textContent = data.Pinnumber;
        document.getElementById("Lifetime").textContent = data.Lifetime;
        document.getElementById("Location").textContent = data.Location;
        document.getElementById("Type_MA").textContent = data.Type_MA;
        document.getElementById("Serial_No_Input").value = '';
   
        if (data.Type_MA === "Tools") {
            $(".Toolvisible").show();
        } else {
            $(".Toolvisible").hide();
        }
        console.log(data);
        document.getElementById("GPVProcess").textContent = data.GPVProcess ? data.GPVProcess : "";
        document.getElementById("ProcessSide").textContent = data.GPVProcess ? data.ProcessSide : "";
        document.getElementById("WithTopCover").textContent = data.GPVProcess ? data.WithTopCover : "";
        document.getElementById("WithControlTooling").textContent = data.GPVProcess ? data.WithControlTooling : "";
        document.getElementById("Grade_Status").textContent = data.GPVProcess ? data.Grade_Status : "";
        document.getElementById("Dimension").textContent = data.Dimension ? data.Dimension : "";

        OnLoad();
    }

    function OnLoad() {
        var dataSet = [];
        var dataFull = [];
        $(data.FilesMAs).each(function (index, item) {
            var newItem = [];
            //var customer = response.data.Customer;

            newItem.push(index + 1);
            newItem.push(item.PlanName || '');
            newItem.push(formatDate(item.Createdate, 1));
            newItem.push(item.Name != null && item.Name != "NO FILE" ? item.Name : '');
            newItem.push(item.ID || '');
            newItem.push(item.ID || '');
            newItem.push(item.Createby || '');
            newItem.push(item.MA_Status || '');
            newItem.push(item.Comment || '');
            //customer.forEach(function (customerItem, index) {
            //    if (item.Customer == customerItem.ID) newItem.push(customerItem.Cust_name);
            //});

            dataSet.push(newItem);
            dataFull.push(item);
        });

        // Destroy the existing DataTable if it exists
        if ($.fn.dataTable.isDataTable('#TableFilesMA')) {
            $('#TableFilesMA').DataTable().clear().destroy();
        }
        $('#TableFilesMA').DataTable({
            order: [[0, "desc"]],
            aLengthMenu: [[25, 50, 100, -1], [25, 50, 100, "All"]],
            iDisplayLength: 100,
            data: dataSet, // This is the array of data that contains your standard packing items
            dom: 'lBfrtip',
            fixedHeader: false,
            autoWidth: true,
            buttons: [],
            scrollX: false,
            buttons: [
                {
                    extend: 'excel',
                    autoFilter: true,
                    exportOptions: {
                        format: {
                            body: function (data, row, col, node) {
                                if (data && /<[^>]+>/g.test(data)) {
                                    if (data && /<br\s*\/?>/i.test(data)) {
                                        data = data.replace(/<br\s*\/?>/gi, ' '); // Replace <br> with a space
                                        return data;
                                    } else {
                                        let htmlString = data;
                                        let parser = new DOMParser();
                                        let doc = parser.parseFromString(htmlString, 'text/html');
                                        let item = doc.body.textContent || doc.body.innerText;
                                        return item;
                                    }
                                }
                                else return data;
                            }
                        }
                    }
                }
            ],
            columns: [
                 {
                     title: "No.",
                     orderable: false,
                     render: function (data, type, row, meta) {
                         return '<i class="fas fa-caret-right" style="font-size: 16px; margin-right: 8px; cursor: pointer;"></i>' + data;
                     }
                 },
                { title: "Plan" },
                { title: "Date" },
                {
                    title: "File",
                    orderable: false,
                    render: function (data, type, row) {
                        if (data) {
                            return '<div style="text-align: center;">' +
                                '<a style="color: #1890ff; font-size: 22px; cursor: pointer;" onclick="renderFile(\'' + row[4] + '\')">' +
                                '<i class="fas fa-file-pdf"></i>' +
                                '</a>' +  
                                '</div>';
                        } else {
                            return 'No files';
                        }
                    }
                },
                {
                    title: "Image Before",
                    orderable: false,
                    render: function (dataid, type, row) {
                        var imageBItem = null;
                        // Use forEach loop to find the matching item
                        if (data.FilesMAs && data.FilesMAs.length > 0) {
                            data.FilesMAs.forEach(function (item) {
                                if (item.ID == dataid) {
                                    imageBItem = item.ImageBefores;
                                }
                            });
                        }

                        if (imageBItem && imageBItem.length > 0) {
                            var button = '<button class="btn btn-filled show-images" data-images=\'' + JSON.stringify(imageBItem) + '\'>View Images</button>';
                            return button;
                        } else {
                            return 'No files';
                        }
                    }
                },
                {
                    title: "Image After",
                    orderable: false,
                    render: function (dataid, type, row) {
                        var imageAItem = null;
                        // Use forEach loop to find the matching item
                        if (data.FilesMAs && data.FilesMAs.length > 0) {
                            data.FilesMAs.forEach(function (item) {
                                if (item.ID == dataid) {
                                    imageAItem = item.ImageAfters;
                                }
                            });
                        }

                        if (imageAItem && imageAItem.length > 0) {
                            var button = '<button class="btn btn-filled show-images" data-images=\'' + JSON.stringify(imageAItem) + '\'>View Images</button>';
                            return button;
                        } else {
                            return 'No files';
                        }
                    }
                },
                { title: "CreateBy" },
                { title: "MA Status" },
                { title: "Comment" }
            ],
            deferRender: true,
            destroy: true,
            createdRow: function (row, data, dataIndex) {
                // Add a click handler to the first column for expanding/collapsing the row
                $(row).on('click', 'td', function () {
                    if ($(this).index() === 0) {
                        var tr = $(this).closest('tr');
                        var row = $('#TableFilesMA').DataTable().row(tr);

                        // Toggle the row's child visibility
                        if (row.child.isShown()) {
                            // If the row is already expanded, collapse it
                            row.child.hide();
                            tr.removeClass('shown');
                            $(row.child()).removeClass('shown-child');
                            $(tr).find('td:first').html('<i class="fas fa-caret-right" style="font-size: 16px; margin-right: 8px; cursor: pointer;"></i> ' + (dataIndex + 1));
                        } else {
                            // If the row is collapsed, expand it
                            row.child(formatDetails(dataFull[dataIndex], dataFull[dataIndex].MAChecklistdetails)).show();

                            $(row.child()).addClass('shown-child');
                            tr.addClass('shown');
                            $(tr).find('td:first').html('<i class="fas fa-caret-down" style="font-size: 16px; margin-right: 8px; cursor: pointer;"></i> ' + (dataIndex + 1));
                        }
                    }
                });
            },
            rowCallback: function (row, data, index) {
                // Add an indicator or style to the row to show it's expandable/collapsible
                $(row).find('td:first').addClass('expandable');
            }
        });

    }

    function formatDetails(data, checklistData) {
        // Add the table HTML
        var detailsHtml = '<button onclick="exportTableToExcel(\'' + data.ID + '\')" class="btn btn-filled" style="margin-bottom: 3px;">Export to Excel</button>';
        detailsHtml += '<table id="table_' + data.ID + ' " class="table table-bordered table-hovered table-striped child-table">';

        // Add the table header (thead)
        detailsHtml += '<thead>' +
            '<tr>' +
                '<th>No</th>' +
                '<th>Checklist Detail</th>' +
                '<th>Status</th>' +
                '<th>Problem</th>' +
                '<th>Remark</th>' +
            '</tr>' +
        '</thead>';

        // Add the table body (tbody)
        detailsHtml += '<tbody>';
        if (checklistData.length > 0) {
            checklistData.forEach(function (item, index) {
                detailsHtml += '<tr>' +
                    '<td>' + (index + 1) + '</td>' +
                    '<td>' + item.Checklistdetail.replace(/\n/g, '<br>') + '</td>' +
                    '<td style="text-align: center;">' + (item.Status == "True" ? '<i class="fas fa-check-circle" style="font-size: 22px;"></i>' : '<i class="fas fa-circle" style="font-size: 22px;"></i>') + '</td>' +
                    '<td>' + (item.Problem || '') + '</td>' +
                    '<td>' + (item.Remark || '') + '</td>' +
                '</tr>';
            });
        } else {
            detailsHtml += '<tr><td colspan="5" style="text-align: center; color: red;">No checklist detail data</td></tr>';
        }

        detailsHtml += '</tbody>';
        detailsHtml += '</table>';
        var tableString = detailsHtml;

        return detailsHtml;
    }

    function exportTableToExcel(id) {
        let tableData = [];
        let dataTopic = {};

        data.FilesMAs.forEach(function (item) {
            if (item.ID == id) {
                dataTopic = item;
                if (Array.isArray(item.MAChecklistdetails)) {
                    item.MAChecklistdetails.forEach(function (checklistItem) {
                        if (checklistItem.Status == "True") {
                            tableData.push({
                                Checklistdetail: checklistItem.Checklistdetail || '',
                                Status:  "✓",
                                Problem: checklistItem.Problem || '',
                                Remark: checklistItem.Remark || '',
                            });
                        }
                    });
                }
            }
        });

        if (tableData.length === 0) {
            showAlert('error', 'No checklist details found for the given ID.', function () { });
            return;
        }

        // Create an Excel workbook using SheetJS
        let wb = XLSX.utils.book_new();

        // Create title/metadata data
        let metadata = [
            ["Serial No", data.Serial_No],
            ["Equipment No", data.Equipment_No],
            ["Equipment Name", data.Equipment_Name],
            ["Poduct Name", data.Product_name],
            ["Type", data.Type_MC],
            ["Maintenance Date", formatDate(dataTopic.Createdate, "1")],
            ["Plan Name", dataTopic.PlanName],
            [], // Empty row for spacing
        ];

        // Convert the metadata into a sheet
        let metadataWs = XLSX.utils.aoa_to_sheet(metadata);

        // Calculate column widths for the metadata sheet
        const metadataColWidths = metadata[0].map(function (col, idx) {
            let maxLength = col.length;  // Start with the length of the header
            metadata.forEach(function (row) {
                let cellValue = row[idx] || '';
                maxLength = Math.max(maxLength, cellValue.length);
            });
            // Add extra space for padding (optional)
            return { wch: maxLength + 2 };
        });

        // Apply the column widths to the metadata sheet
        metadataWs['!cols'] = metadataColWidths;

        // Add the metadata sheet to the workbook
        XLSX.utils.book_append_sheet(wb, metadataWs, "Maintenance Detail");

        // Convert the tableData into a sheet with the correct column headers
        let ws = XLSX.utils.json_to_sheet(tableData, {
            header: ["Checklistdetail", "Status", "Problem", "Remark"], // Define the header order explicitly
        });

        // Calculate column widths for the checklist detail sheet
        const checklistColWidths = ["Checklistdetail", "Status", "Problem", "Remark"].map(function (col) {
            let maxLength = 0;
            tableData.forEach(function (row, index) {
                let cellValue;
                if (index == 1) cellValue = 'Status';
                else cellValue = row[col] || '';
                maxLength = Math.max(maxLength, cellValue.length);
            });
            // Add extra space for padding (optional)
            return { wch: maxLength + 2 };
        });

        // Apply the calculated column widths to the checklist detail sheet
        ws['!cols'] = checklistColWidths;

        // Add the checklist detail sheet to the workbook
        XLSX.utils.book_append_sheet(wb, ws, "Checklist Detail");

        // Generate the Excel file and trigger download
        XLSX.writeFile(wb, ("MAFixture_" + data.Equipment_No + "_" + formatDate(dataTopic.Createdate, "2") + '.xlsx'));
    }

    function renderFile(ID) {
        window.open('/MATesting/Global/ViewFile?id=' + ID, '_blank');
    }
</script>