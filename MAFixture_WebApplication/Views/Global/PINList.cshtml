
@{
    ViewBag.Title = "PinList";
}

<h3>Pin List</h3>
<hr />

<div class="col-custom">
    <div class="row">
        <div class="col-md-2 col-12 mb-3" style="padding: 0px 0px;">
            <button onclick="OnAdd()" class="btn btn-filled">Add new Pin list</button>
        </div>
    </div>
</div>
<div class="col-custom">
    <div class="row">
        <div class="col-12 mb-3" style="padding: 3px 0px;">
            <div id="TableForm" class="form-inline" style="padding-top: 20px; width: 100%; font-size: 12px !important;">
                @*<table id="TableCustomer" class="table table-bordered table-hover" style="width: 100%; border-collapse: collapse !important; font-size: 11px !important; table-layout: fixed; "></table>*@
                <table id="TablePinList" class="table table-bordered table-hover" style="width: 100%; border-collapse: collapse !important; font-size: 13px !important;"></table>
            </div>
        </div>
    </div>
</div>

<script>
 $(document).ready(function () {
        OnLoad()
    });

    function OnLoad() {
        var dataSet = [];
        var dataFull = [];

        var url = '@Url.Action("Load_All_Lists", "Global")';

        $.ajax({
            type: 'POST',
            url: url,
            contentType: "application/json; charset=utf-8",
            data: "",
            dataType: "json",
            async: true,
            success: function (response) {
                if (response.success) {
                    if (response.data) {
                        var emailList = response.data.Pinnumber;
                        $(emailList).each(function (index, item) {
                            var newItem = [];
                            newItem.push(index + 1);
                            newItem.push(item.ID);
                            newItem.push(item.Pinname || '');
                            newItem.push(item.Pinnumber || '');
                            newItem.push(item.Product || '');
                            newItem.push(item.Lifetime || '');

                            dataSet.push(newItem);
                            dataFull.push(item);
                        });

                        // Destroy the existing DataTable if it exists
                        if ($.fn.dataTable.isDataTable('#TablePinList')) {
                            $('#TablePinList').DataTable().clear().destroy();
                        }

                        $('#TablePinList').DataTable({
                            order: [[0, "desc"]],
                            aLengthMenu: [[25, 50, 100, -1], [25, 50, 100, "All"]],
                            iDisplayLength: 100,
                            data: dataSet, // This is the array of data that contains your standard packing items
                            dom: 'lBfrtip',
                            fixedHeader: true,
                            autoWidth: true,
                            buttons: [],
                            scrollX: false,
                            buttons: [
                                {
                                    extend: 'excel',
                                    autoFilter: true,
                                    exportOptions: {
                                        format: {
                                            body: function (data, row, col, node) {
                                                if (data && /<[^>]+>/g.test(data)) {
                                                    if (data && /<br\s*\/?>/i.test(data)) {
                                                        data = data.replace(/<br\s*\/?>/gi, ' '); // Replace <br> with a space
                                                        return data;
                                                    } else {
                                                        let htmlString = data;
                                                        let parser = new DOMParser();
                                                        let doc = parser.parseFromString(htmlString, 'text/html');
                                                        let item = doc.body.textContent || doc.body.innerText;
                                                        return item;
                                                    }
                                                }
                                                else return data;
                                            }
                                        }
                                    }
                                }
                            ],
                            columns: [
                                { title: "No." },
                                {
                                    title: "Action",
                                    orderable: false,
                                    render: function (data, type, row) {
                                        return '<div style="width: 100%; display: flex; justify-content: space-around; column-gap: 3px;">' +
                                            '<button onclick="OnEdit(\'' + data + '\')" class="btn btn-filled">Edit</button>' +
                                            '<button onclick="OnDelete(\'' + data + '\')" class="btn btn-transparent">Delete</button>' +
                                            '</div>'
                                    },
                                },
                                { title: "Pinname" },
                                { title: "Pinnumber" },
                                { title: "Product" },
                                { title: "Lifetime" },
                            ],
                            deferRender: true,
                            destroy: true
                        });
                    }
                } else {
                    showAlert('error', response.word, function () { });
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }
    function OnAdd(data) {
        document.location = '@Url.Action("ManagePinList", "Global")';
    }

    function OnEdit(data) {
        document.location = '@Url.Action("ManagePinList", "Global")' + '?id=' + data;
    }

    function OnDelete(data) {
        confirm("Are you sure you want to delete?", function () {
            var url = '@Url.Action("Delete_PinList_By_ID", "Global")';
            var dataJson = JSON.stringify({ ID: data });

            $.ajax({
                type: 'POST',
                url: url,
                data: dataJson,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: true,
                success: function (response) {
                    if (response.success) {
                        showAlert('success', response.word, function () { });
                        OnLoad();
                    } else {
                        showAlert('error', response.word, function () { });
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
                }
            });
        }, function () {
            console.log("Cancel");
        });
    }
</script>

