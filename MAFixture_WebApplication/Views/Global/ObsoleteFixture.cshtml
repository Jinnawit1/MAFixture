@{
    ViewBag.Title = "Obsolete Fixture";
}

<style>
    .shown {
        background-color: #e6f7ff !important;
    }

    .shown-child {
        background-color: #e6f7ff !important;
    }

    .action {
        padding: 7px;
        border-radius: 4px;
        width: 100%;
        text-align: center;
        color: white;
        cursor: pointer;
        font-size: 15px;
    }
</style>

<h3>Obsolete Fixture</h3>
<hr />

<div class="filter-card">
    <div class="filter-card-header">
        <div>
            <i class="fas fa-filter" style="color: #1890ff; margin-right: 6px;"></i> Search Filters
        </div>
    </div>
    <div class="filter-card-body">
        <div class="row">
            <!-- Row 1 -->
            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="Serial_No">Serial No :</label>
                    <input type="text" class="form-control" id="Serial_No" placeholder="Enter Serial No">
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="Equipment_Name">Equipment Name :</label>
                    <input type="text" class="form-control" id="Equipment_Name" placeholder="Enter Equipment Name">
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="From">LastMA Date From :</label>
                    <input type="date" class="form-control" id="From">
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="To">LastMA Date To :</label>
                    <input type="date" class="form-control" id="To">
                </div>
            </div>

            <!-- Row 2 -->
            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="Customer">Customer :</label>
                    <input type="text" class="form-control" id="Customer" placeholder="Enter Customer">
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="Product_name">Product Name :</label>
                    <input type="text" class="form-control" id="Product_name" placeholder="Enter Product Name">
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="Section">Section :</label>
                    <select class="form-control" id="Section">
                        <option value="" selected>All</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="Type_MC">Type MC :</label>
                    <select class="form-control" id="Type_MC">
                        <option value="" selected>All</option>
                        <option value="0">Maintenance</option>
                        <option value="1">Calibration</option>
                    </select>
                </div>
            </div>

            <!-- Row 3 -->
            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="Type_MA">Type MA :</label>
                    <select class="form-control" id="Type_MA">
                        <option value="" selected>All</option>
                        <option value="0">Equipment/Machine</option>
                        <option value="1">Sparepart</option>
                        <option value="2">Tools</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="Type_Tools">Type Tools :</label>
                    <select class="form-control" id="Type_Tools">
                        <option value="" selected>All</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="Location">Location :</label>
                    <input type="text" class="form-control" id="Location" placeholder="Enter Location">
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                <div class="form-group">
                    <label for="Property">Property :</label>
                    <select class="form-control" id="Property">
                        <option value="" selected>All</option>
                        <option value="GPV">GPV</option>
                        <option value="Customer">Customer</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="filter-card-footer">
        <button type="button" class="btn-filter-search" id="search-button" onclick="OnLoad()">
            <i class="fas fa-search"></i> Search
        </button>
        <button type="button" class="btn-filter-reset" id="reset-button" onclick="OnReset()">
            <i class="fas fa-undo"></i> Reset
        </button>
    </div>
</div>

<div class="col-custom">
    <div class="row">
        <div class="col-12 mb-3" style="padding: 3px 0px;">
            <div id="TableForm" style="padding-top: 20px; width: 100%; font-size: 12px !important;">
                @*<table id="TableSP" class="table table-bordered table-hover" style="width: 100%; border-collapse: collapse !important; font-size: 11px !important; table-layout: fixed; "></table>*@
                <table id="TableMAPlan" class="table table-bordered table-hover" style="width: 100%; border-collapse: collapse !important; font-size: 13px !important;"></table>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        LoadAll();
        $('.filter-card input').keypress(function (e) {
            if (e.which === 13) {
                OnLoad();
            }
        });
    });

    function LoadAll() {
        var url = '@Url.Action("Load_Common_Filters", "Global")';

        $.ajax({
            type: 'POST',
            url: url,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                if (response.success && response.data) {
                    if (response.data.Department) {
                        $.each(response.data.Department, function (index, item) {
                            if (item && item.Section) {
                                $('#Section').append('<option value="' + item.Section + '">' + item.Section + '</option>');
                            }
                        });
                    }

                    if (response.data.ToolTypes) {
                        $.each(response.data.ToolTypes, function (index, item) {
                            if (item) {
                                $('#Type_Tools').append('<option value="' + item + '">' + item + '</option>');
                            }
                        });
                    }

                    OnLoad();
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

    function OnReset() {
        $('#Serial_No').val('');
        $('#Equipment_Name').val('');
        $('#From').val('');
        $('#To').val('');
        $('#Customer').val('');
        $('#Product_name').val('');
        $('#Section').val('');
        $('#Type_MC').val('');
        $('#Type_MA').val('');
        $('#Type_Tools').val('');
        $('#Location').val('');
        $('#Property').val('');
        OnLoad();
    }

    function OnLoad() {
        var Serial_No = $('#Serial_No').val();
        var Equipment_Name = $('#Equipment_Name').val();
        var From = $('#From').val();
        var To = $('#To').val();
        var Customer = $('#Customer').val();
        var Product_name = $('#Product_name').val();
        var Section = $('#Section').val();
        var Type_MC = $('#Type_MC').val();
        var Type_MA = $('#Type_MA').val();
        var Type_Tools = $('#Type_Tools').val();
        var Location = $('#Location').val();
        var Property = $('#Property').val();
        var dataSet = [];
        var dataFull = [];
        var url = '@Url.Action("Load_Obsolete", "Global")';

        $.ajax({
            type: 'POST',
            url: url,
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({
                Serial_No: Serial_No,
                Equipment_Name: Equipment_Name,
                From: From,
                To: To,
                Customer: Customer,
                Product_name: Product_name,
                Section: Section,
                Type_MC: Type_MC,
                Type_MA: Type_MA,
                Type_Tools: Type_Tools,
                Location: Location,
                Property: Property
            }),
            dataType: "json",
            async: true,
            success: function (response) {
                if (response.success && response.data) {
                    var maPlan = response.data;
                    $(maPlan).each(function (index, item) {
                                            var newItem = [];
                                            newItem.push(index + 1);
                                            newItem.push(item.MA_ID || '');
                                            newItem.push(item.Serial_No || '');
                                            newItem.push(item.Equipment_No || '');
                                            newItem.push(item.Equipment_Name || '');
                                            newItem.push(item.Product_name || '');
                                            newItem.push(item.Type_MC || '');
                                            newItem.push(item.Section || '');
                                            newItem.push(item.Customer_Name || '');
                                            newItem.push(formatDate(item.LastMA_date, "2"));

                                            dataSet.push(newItem);
                                            dataFull.push(item);
                                        });

                                        // Destroy the existing DataTable if it exists
                                        if ($.fn.dataTable.isDataTable('#TableMAPlan')) {
                                            $('#TableMAPlan').DataTable().clear().destroy();
                                        }

                                        $('#TableMAPlan').DataTable({
                                            order: [[0, "desc"]],
                                            aLengthMenu: [[25, 50, 100, -1], [25, 50, 100, "All"]],
                                            iDisplayLength: 100,
                                            data: dataSet, // This is the array of data that contains your standard packing items
                                            dom: 'lBfrtip',
                                            fixedHeader: true,
                                            autoWidth: true,
                                            buttons: [],
                                            scrollX: false,
                                            buttons: [
                                                {
                                                    extend: 'excel',
                                                    autoFilter: true,
                                                    exportOptions: {
                                                        format: {
                                                            body: function (data, row, col, node) {
                                                                if (data && /<[^>]+>/g.test(data)) {
                                                                    if (data && /<br\s*\/?>/i.test(data)) {
                                                                        data = data.replace(/<br\s*\/?>/gi, ' '); // Replace <br> with a space
                                                                        return data;
                                                                    } else {
                                                                        let htmlString = data;
                                                                        let parser = new DOMParser();
                                                                        let doc = parser.parseFromString(htmlString, 'text/html');
                                                                        let item = doc.body.textContent || doc.body.innerText;
                                                                        return item;
                                                                    }
                                                                }
                                                                else return data;
                                                            }
                                                        }
                                                    }
                                                }
                                            ],
                                            columns: [
                                                {
                                                    title: "No.",
                                                    orderable: false,
                                                    render: function (data, type, row, meta) {
                                                        return '<i class="fas fa-caret-right" style="font-size: 16px; margin-right: 8px; cursor: pointer;"></i>' + data;
                                                    }
                                                },
                                                {
                                                    title: "View",
                                                    orderable: false,
                                                    className: "text-center",
                                                    render: function (data, type, row) {
                                                        return '<button type="button" class="table-action-btn btn-view" title="View MA History" onclick="OnDetail(\'' + data + '\')"><i class="fas fa-search"></i></button>';
                                                    },
                                                },
                                                { title: "Serial No" },
                                                { title: "Equipment No" },
                                                { title: "Equipment Name" },
                                                { title: "Product Name" },
                                                { title: "Type MC" },
                                                { title: "Section" },
                                                { title: "Customer" },
                                                { title: "LastMA Date" }
                                            ],
                                            deferRender: true,
                                            destroy: true,
                                            createdRow: function (row, data, dataIndex) {
                                                // Add a click handler to the first column for expanding/collapsing the row
                                                $(row).on('click', 'td', function () {
                                                    if ($(this).index() === 0) {
                                                        var tr = $(this).closest('tr');
                                                        var row = $('#TableMAPlan').DataTable().row(tr);

                                                        // Toggle the row's child visibility
                                                        if (row.child.isShown()) {
                                                            // If the row is already expanded, collapse it
                                                            row.child.hide();
                                                            tr.removeClass('shown');
                                                            $(row.child()).removeClass('shown-child');
                                                            $(tr).find('td:first').html('<i class="fas fa-caret-right" style="font-size: 16px; margin-right: 8px; cursor: pointer;"></i> ' + (dataIndex + 1));
                                                        } else {
                                                            // If the row is collapsed, expand it
                                                            row.child(formatDetails(dataFull[dataIndex])).show();

                                                            $(row.child()).addClass('shown-child');
                                                            tr.addClass('shown');
                                                            $(tr).find('td:first').html('<i class="fas fa-caret-down" style="font-size: 16px; margin-right: 8px; cursor: pointer;"></i> ' + (dataIndex + 1));
                                                        }
                                                    }
                                                });
                                            },
                                            rowCallback: function (row, data, index) {
                                                // Add an indicator or style to the row to show it's expandable/collapsible
                                                $(row).find('td:first').addClass('expandable');
                                            }
                                        });
                    } else {
                        showAlert('error', response.word || 'Error loading data', function () { });
                    }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

    function formatDetails(data) {
        return '<div style="display: flex; gap: 8px; align-items: center; padding: 6px 4px;">' +
                '<button type="button" class="table-action-btn btn-recover" onclick="OnRecover(\'' + data.MA_ID + '\')"><i class="fas fa-trash-restore"></i> Recover</button>' +
            '</div>';
    }

    function OnDetail(data) {
        document.location = '@Url.Action("MaintenanceHistory", "Global")' + '?id=' + data;
    }

    function OnEdit(data) {
        document.location = '@Url.Action("NewEquipment", "Global")' + '?serialNo=' + data;
    }

    function OnRecover(data) {
        confirm(("Are you sure you want to recover fixture ID: " + data + "?"), function () {
            var url = '@Url.Action("Recover_Fixture_By_MA_ID", "Global")';
            var dataJson = JSON.stringify({ MA_ID: data })

            $.ajax({
                type: 'POST',
                url: url,
                data: dataJson,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: true,
                success: function (response) {
                    if (response.success) {
                        showAlert('success', response.word, function () { });
                        OnLoad();
                    } else showAlert('error', response.word, function () { });
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
                }
            });
        }, function () { });
    }
</script>