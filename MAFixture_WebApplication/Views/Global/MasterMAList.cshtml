
@{
    ViewBag.Title = "MasterMAList";
}

<h3>MasterMA List</h3>
<hr />
<div class="row">
    <div class="col-md-3 col-sm-3 col-12 mb-3">
        <div class="form-group">
            <label>Detail Eng :</label>
            <input type="text" class="form-control" id="DetailEng">
        </div>
    </div>
    <div class="col-md-3 col-sm-3 col-12 mb-3">
        <div class="form-group">
            <label>Detail Thai :</label>
            <input type="text" class="form-control" id="DetailThai">
        </div>
    </div>
    <div class="col-md-3 col-sm-3 col-12 mb-3">
        <div class="form-group">
            <label for="search-date-to">Category :</label>
            <select  class="form-control" id="Category">
                <option value="" selected>All</option>
                <option value="Daily">Daily</option>
                <option value="Weekly">Weekly</option>
                <option value="Monthly">Monthly</option>
                <option value="Quarterly">Quarterly</option>
                <option value="Semi_annually">Semi_annually</option>
                <option value="Yearly">Yearly</option>
                <option value="Manually">Manually</option>
            </select>
        </div>
    </div>
    <div class="col-md-3 col-sm-3 col-12 mb-3">
        <div class="form-group">
            <label for="search-request-by">Section :</label>
            <select  class="form-control" id="Section">
                <option value="" selected>All</option>
            </select>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-3 col-sm-3 col-12 mb-3">
        <div class="form-group">
            <label for="search-date-from">Machine Name :</label>
            <input type="text" class="form-control" id="Machinename">
        </div>
    </div>
    <div class="col-md-3 col-sm-3 col-12 mb-3">
        <div class="form-group">
            <label for="search-request-by">Type:</label>
            <select class="form-control" id="Type_MA">
                <option value="" selected>All</option>
                <option value="Equipment/Machine">Equipment/Machine</option>
                <option value="Sparepart">Sparepart</option>
                <option value="Tools">Tools</option>
            </select>
        </div>
    </div>
   
</div>
<div style="margin-left:15px;margin-bottom:10px">
    <button class="btn btn-primary" id="search-button" onclick="OnLoad()">Search</button>

</div>

<div class="col-custom">
    <div class="row">
        <div class="col-md-2 col-12 mb-3" style="padding: 0px 0px;">
            <button onclick="OnAdd()" class="btn btn-filled">Add new MasterMA list</button>
        </div>
    </div>
</div>

<div class="col-custom">
    <div class="row">
        <div class="col-12 mb-3" style="padding: 3px 0px;">
            <div id="TableForm" class="form-inline" style="padding-top: 10px; width: 100%; font-size: 12px !important;">
                @*<table id="TableCustomer" class="table table-bordered table-hover" style="width: 100%; border-collapse: collapse !important; font-size: 11px !important; table-layout: fixed; "></table>*@
                <table id="TableMasterMAList" class="table table-bordered table-hover" style="width: 100%; border-collapse: collapse !important; font-size: 13px !important;"></table>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        LoadAll()
    });
    function LoadAll() {
        var url = '@Url.Action("Load_All_Lists", "Global")';

        $.ajax({
            type: 'POST',
            url: url,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                if (response.success) {
                    if (response.data) {
                        console.log(response.data);
                        $.each(response.data.Department, function (index, item) {
                            $('#Section').append('<option value="' + item.Section + '">' + item.Section + '</option>');
                        });
                        OnLoad();
                    }
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

    function OnLoad() {
        var DetailEng = $("#DetailEng").val();
        var DetailThai = $("#DetailThai").val();
        var Category = $("#Category").val();
        var Section = $("#Section").val();
        var Machinename = $("#Machinename").val();
        var Type_MA = $("#Type_MA").val();
        var dataSet = [];
        var dataFull = [];

        var url = '@Url.Action("Load_MasterMA", "Global")';

        $.ajax({
            type: 'POST',
            url: url,
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({
                DetailEng: DetailEng,
                DetailThai: DetailThai,
                Category: Category,
                Section: Section,
                Machinename: Machinename,
                Type_MA: Type_MA,
            }),
            dataType: "json",
            async: true,
            success: function (response) {
                if (response.success) {
                    if (response.data) {
                        var data = response.data;
                        $(data).each(function (index, item) {
                            var newItem = [];
                            newItem.push(index + 1);
                            newItem.push(item.ID);
                            newItem.push(item.DetailEng + '<br>' + item.DetailThai || '');
                            newItem.push(item.Category || '');
                            newItem.push(item.Section || '');
                            newItem.push(item.Machinename || '');
                            newItem.push(item.Type_MA || '');
                            newItem.push(item.Updateby || '');
                            newItem.push(formatDate(item.Updatedate,"2") || '');
                            dataSet.push(newItem);
                            dataFull.push(item);
                        });

                        // Destroy the existing DataTable if it exists
                        if ($.fn.dataTable.isDataTable('#TableMasterMAList')) {
                            $('#TableMasterMAList').DataTable().clear().destroy();
                        }

                        $('#TableMasterMAList').DataTable({
                            order: [[0, "desc"]],
                            aLengthMenu: [[25, 50, 100, -1], [25, 50, 100, "All"]],
                            iDisplayLength: 100,
                            data: dataSet, // This is the array of data that contains your standard packing items
                            dom: 'lBfrtip',
                            fixedHeader: true,
                            autoWidth: true,
                            buttons: [],
                            scrollX: false,
                            buttons: [
                                {
                                    extend: 'excel',
                                    autoFilter: true,
                                    exportOptions: {
                                        format: {
                                            body: function (data, row, col, node) {
                                                if (data && /<[^>]+>/g.test(data)) {
                                                    if (data && /<br\s*\/?>/i.test(data)) {
                                                        data = data.replace(/<br\s*\/?>/gi, ' '); // Replace <br> with a space
                                                        return data;
                                                    } else {
                                                        let htmlString = data;
                                                        let parser = new DOMParser();
                                                        let doc = parser.parseFromString(htmlString, 'text/html');
                                                        let item = doc.body.textContent || doc.body.innerText;
                                                        return item;
                                                    }
                                                }
                                                else return data;
                                            }
                                        }
                                    }
                                }
                            ],
                            columns: [
                                { title: "No." },
                                {
                                    title: "Action",
                                    orderable: false,
                                    render: function (data, type, row) {
                                        return '<div style="width: 100%; display: flex; justify-content: space-around; column-gap: 3px;">' +
                                            '<button onclick="OnEdit(\'' + data + '\')" class="btn btn-filled">Edit</button>' +
                                            '<button onclick="OnDelete(\'' + data + '\')" class="btn btn-transparent">Delete</button>' +
                                            '</div>'
                                    },
                                },
                                { title: "Detail" },
                                { title: "Category" },
                                { title: "Section" },
                                { title: "Machinename" },
                                { title: "Type" },
                                { title: "Updateby" },
                                { title: "Updatedate" },
                            ],
                            deferRender: true,
                            destroy: true
                        });
                    }
                } else {
                    showAlert('error', response.word, function () { });
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

    function OnAdd(data) {
        document.location = '@Url.Action("ManageMasterMAList", "Global")';
    }

    function OnEdit(data) {
        document.location = '@Url.Action("ManageMasterMAList", "Global")' + '?id=' + data;
    }

    function OnDelete(data) {
        confirm("Are you sure you want to delete?", function () {
            var url = '@Url.Action("Delete_MasterMAList_By_ID", "Global")';
            var dataJson = JSON.stringify({ ID: data });

            $.ajax({
                type: 'POST',
                url: url,
                data: dataJson,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: true,
                success: function (response) {
                    if (response.success) {
                        showAlert('success', response.word, function () { });
                        OnLoad();
                    } else {
                        showAlert('error', response.word, function () { });
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
                }
            });
        }, function () {
            console.log("Cancel");
        });
    }
</script>