@{
    ViewBag.Title = "Instruction Videos";
}

<h2 class="mb-4">Instruction Videos</h2>
<hr />

<div class="container">
    <div class="row">
        <div class="col-md-4 mb-4 text-center">
            <i class="fas fa-file-video fa-3x text-warning mb-2"></i>
            <h5>Register Fixture</h5>
            <a href="@Url.Content("~/Video/MAFixture Instruction (Register Fixture).mp4")" style="color:blue" class="btn btn-sm btn-outline-warning" target="_blank">
                <i class="fas fa-play-circle"></i> Watch
            </a>
        </div>

        <div class="col-md-4 mb-4 text-center">
            <i class="fas fa-file-video fa-3x text-success mb-2"></i>
            <h5>Record Maintenance Plan</h5>
            <a href="@Url.Content("~/Video/MAFixture Instruction (Record Maintenance Plan).mp4")" style="color: blue" class="btn btn-sm btn-outline-success" target="_blank">
                <i class="fas fa-play-circle"></i> Watch
            </a>
        </div>

        <div class="col-md-4 mb-4 text-center">
            <i class="fas fa-file-video fa-3x text-primary mb-2"></i>
            <h5>Manage Email</h5>
            <a href="@Url.Content("~/Video/MAFixture Instruction (Manage Email).mp4")" style="color: blue" class="btn btn-sm btn-outline-primary" target="_blank">
                <i class="fas fa-play-circle"></i> Watch
            </a>
        </div>

    </div>
</div>
