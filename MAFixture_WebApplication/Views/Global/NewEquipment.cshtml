    function checkDuplicates(data) {
        var url = '@Url.Action("CheckForDuplicateNames", "Global")';
        var dataJson = JSON.stringify({ serialNo: data.serialNo, Equipment_No: data.Equipment_No, maId: data.maId })

        $.ajax({
            type: 'POST',
            url: url,
            data: dataJson,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                if (!response.success) {
                    showAlert('error', response.word, function () { });
