    function Record_MAPlan(data, replace)
    {
        var url = '@Url.Action("Record_MAPlan", "Global")';
        var dataJson = JSON.stringify({ data: data, replace: replace, source: "NewEquipment" });
        console.log(data);
        $.ajax({
            type: 'POST',
            url: url,
            data: dataJson,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                if (response.success) {
                    if (response.data) {
                        showAlert('success', response.word, function () { });
                        onCancel();
                    }
                } else {
                    showAlert('error', response.word, function () { });
                }
            }, error: function (jqXHR, textStatus, errorThrown) { showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { }); }
