@{
    ViewBag.Title = "New Equipment";
}

<h3 id="topic"></h3>
<hr />

<style>
</style>
<div class="row">
    <div class="col-md-3">
        <div class="panel panel-default">
            <div class="panel-heading">
                <b>Picture</b>
            </div>
            <div class="panel-body text-center">
                <!-- Preview -->
                <img id="image-preview-after"
                     src=""
                     style="width:100%; max-height:200px; object-fit:contain; border:1px solid #ddd; padding:5px; margin-bottom:10px;"
                     alt="No Image" />
                <!-- Upload -->
                <div class="input-file-container">
                    <input type="file"
                           id="file-input-after"
                           accept=".jpg, .jpeg, .png, .heic"
                           class="file-input"
                           onchange="previewImage(event)"
                           style="display: none;">
                    <label for="file-input-after" class="btn btn-default" style="width:100%;">
                        Choose File
                    </label>
                    <div id="file-name-after" style="margin-top:5px; font-size:12px; color:#777;">
                        No file selected
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-9">
        <div class="col-custom">
            <div class="row">
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Department :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <select class="ant-select" name="Department" id="Department"></select>
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3">
                    <div>MA type :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <label class="container">
                        Maintenance
                        <input type="radio" checked="checked" value="Maintenance" name="Type_MC">
                        <span class="checkmark"></span>
                    </label>
                    <label class="container">
                        Calibration
                        <input type="radio" value="Calibration" name="Type_MC">
                        <span class="checkmark"></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="col-custom">
            <div class="row">
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div><span style="color: red;">*</span>Customer :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <select class="ant-select" name="Customer" id="Customer"></select>
                    <input name="Customerid" id="Customerid" hidden />
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Drawing :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <select class="form-control" name="Drawing" id="Drawing"></select>
                </div>
            </div>
        </div>
        <div class="col-custom">
            <div class="row">

                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>MA type :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3" style=" padding-top: 10px;">
                    <label class="container">
                        Equipment/Machine
                        <input type="radio" checked="checked" value="Equipment/Machine" name="Type_MA">
                        <span class="checkmark"></span>
                    </label>
                    <label class="container">
                        SparePart
                        <input type="radio" value="Sparepart" name="Type_MA">
                        <span class="checkmark"></span>
                    </label>
                    <label class="container">
                        Tools
                        <input type="radio" value="Tools" name="Type_MA">
                        <span class="checkmark"></span>
                    </label>
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div><span style="color: red;">*</span>Product name :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <textarea class="form-control" id="Product_name" style="height:80px" name="Product_name" placeholder="Product name"></textarea>  @*readonly onmouseover="this.removeAttribute('readonly')"*@
                </div>
            </div>
        </div>
        <div class="col-custom">
            <div class="row">
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div><span style="color: red;">*</span>Serial no :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <input type="text" class="form-control" id="Serial_No" name="Serial_No" placeholder="Serial no" /> @*readonly onmouseover="this.removeAttribute('readonly')"*@
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div><span style="color: red;">*</span>Equipment no :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <input type="text" class="form-control" id="Equipment_No" name="Equipment_No" placeholder="Machine/Equipment no" /> @*readonly onmouseover="this.removeAttribute('readonly')"*@
                </div>

            </div>
        </div>
        <div class="col-custom">
            <div class="row">
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div><span style="color: red;">*</span>Equipment name :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <input type="text" class="form-control" id="Equipment_Name" name="Equipment_Name" placeholder="Machine/Equipment name" /> @*readonly onmouseover="this.removeAttribute('readonly')"*@
                    <input type="hidden" class="form-control" id="Equipment_Name_old" />
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Model no :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <input type="text" class="form-control" id="Model" name="Model" placeholder="Model no" /> @*readonly onmouseover="this.removeAttribute('readonly')"*@
                </div>
            </div>
        </div>
        <div class="col-custom">
            <div class="row">
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Reference no :</div>
                    <small class="text-muted" style="color:red;">(Serial Of Fixture)</small>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <input class="form-control" list="Referrence_No_List" name="Referrence_No" id="Referrence_No">
                    <datalist id="Referrence_No_List"></datalist>
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Responsible name :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <input type="text" class="form-control" id="Responsible_Name" name="Responsible_Name" placeholder="Refference name" /> @*readonly onmouseover="this.removeAttribute('readonly')"*@
                </div>
            </div>
        </div>
        <div class="col-custom">
            <div class="row">
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Manufacture :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <input type="text" class="form-control" id="Manufacture" name="Manufacture" placeholder="Manufacture" /> @*readonly onmouseover="this.removeAttribute('readonly')"*@
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Property :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3" style="padding-top: 10px;">
                    <label class="container">
                        GPV
                        <input type="radio" checked="checked" value="GPV" name="Property">
                        <span class="checkmark"></span>
                    </label>
                    <label class="container">
                        Customer
                        <input type="radio" value="Customer" name="Property">
                        <span class="checkmark"></span>
                    </label>
                </div>
            </div>
        </div>

        <div class="col-custom">
            <div class="row">
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Pin No. :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <select class="ant-select" name="Pinnumber" id="Pinnumber"></select>
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Lifetime :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <input type="text" class="form-control" id="Lifetime" name="Lifetime" placeholder="Lifetime" /> @*readonly onmouseover="this.removeAttribute('readonly')"*@
                </div>
            </div>
        </div>


        <div class="col-custom">
            <div class="row">
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Location :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <input type="text" class="form-control" id="Location" name="Location" placeholder="Location" /> @*readonly onmouseover="this.removeAttribute('readonly')"*@
                </div>
                <div class="row">
                    <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                        <div><span id="req_Description" style="color: red; display: none;">*</span>Description :</div>
                    </div>
                    <div class="col-md-4 col-sm-4 col-12 mb-3">
                        <textarea class="form-control" id="Description" name="Description" placeholder="Description"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-custom Toolvisible">
            <div class="row">
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div><span style="color: red;">*</span>Type Tools :</div>
                </div>
                <div class="col-md-10 col-sm-10 col-12 mb-3" style="padding-top: 10px;">
                    <label class="container">
                        Selective
                        <input type="radio" value="Selective" name="Type_tools">
                        <span class="checkmark"></span>
                    </label>
                    <label class="container">
                        Wave
                        <input type="radio" value="Wave" name="Type_tools">
                        <span class="checkmark"></span>
                    </label>
                    <label class="container">
                        SMT Pallet
                        <input type="radio" value="SMT_Pallet" name="Type_tools">
                        <span class="checkmark"></span>
                    </label>
                    <label class="container">
                        other
                        <input type="radio" value="other" name="Type_tools">
                        <span class="checkmark"></span>
                    </label>
                </div>
            </div>
        </div>

        <div class="col-custom Toolvisible">
            <div class="row">
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>GPV-Process :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <input type="text" class="form-control" id="GPVProcess" name="GPVProcess" placeholder="Wave / Solder" /> @*readonly onmouseover="this.removeAttribute('readonly')"*@
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Process-Side :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <select class="ant-select" name="ProcessSide" id="ProcessSide">
                        <option value="" selected>N/A</option>
                        <option value ="Top">Top</option>
                        <option value="Bottom">Buttom</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                </div>

            </div>
        </div>

        <div class="col-custom Toolvisible">
            <div class="row">
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>WithTopCover :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <select class="ant-select" name="WithTopCover" id="WithTopCover">
                        <option value="" selected>N/A</option>
                        <option value="Yes">Yes</option>
                        <option value="No">No</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>WithControlTooling :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <select class="ant-select" name="WithControlTooling" id="WithControlTooling">
                        <option value="" selected>N/A</option>
                        <option value="Yes">Yes</option>
                        <option value="No">No</option>
                    </select>
                </div>
            </div>
        </div>


        <div class="col-custom Toolvisible" style="padding-top:10px">
            <div class="row">
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Grade Status :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3">
                    <select class="ant-select" name="Grade_Status" id="Grade_Status">
                        <option value="" selected>N/A</option>
                        <option value="A">A</option>
                        <option value="B">B</option>
                        <option value="C">C</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Dimension :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-xs-12">
                    <div class="unit-input">
                        <input type="text" id="Dimension" class="form-control" placeholder="Width x Length x Height">
                        <span class="unit">cm</span>
                    </div>
                </div>

            </div>
        </div>


        <div class="col-custom" id="Adddate" style="display:none;">
            <div class="row">
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Plan :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3" style="padding-top: 10px;">
                    <div class="checkbox-group">
                        <label>
                            <input type="checkbox" value="1" checked> Daily
                        </label>
                        <label>
                            <input type="checkbox" value="2"> Weekly
                        </label>
                        <label>
                            <input type="checkbox" value="3"> Monthly
                        </label>
                        <label>
                            <input type="checkbox" value="4"> Quarterly
                        </label>
                        <label>
                            <input type="checkbox" value="5"> Semi_annually
                        </label>
                        <label>
                            <input type="checkbox" value="6"> Yearly
                        </label>
                        <label>
                            <input type="checkbox" value="7"> Manually
                        </label>
                    </div>
                </div>
                @*<div class="input-file-container">
                    <div style="display: flex; justify-content: space-between;">
                        <label for="file-input-after">Upload File</label>
                    </div>
                    <input type="file" id="file-input-after" accept=".jpg, .jpeg, .png, .heic" class="file-input" onchange="updateFileName('after')" style="display: none;">
                    <label for="file-input-after" class="file-label">
                        Choose File
                        <span id="file-name-after">No file selected</span>
                    </label>
                    <div id="image-preview-container-after" style="display: none; flex-direction: column; column-gap: 3px;">
                    </div>
                </div>*@
            </div>
        </div>

        <div class="col-custom" id="Editdate" style="display:none;">
            <div class="row">
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Daily :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3" style="padding-top: 10px;">
                    <input id="Daily" class="form-control" type="datetime-local" style="margin-right:20PX;" />
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Weekly :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3" style="padding-top: 10px;">
                    <input id="Weekly" class="form-control" type="datetime-local" style="margin-right: 20PX;" />

                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Monthly :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3" style="padding-top: 10px;">
                    <input id="Monthly" class="form-control" type="datetime-local" style="margin-right: 20PX;" />

                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Quarterly :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3" style="padding-top: 10px;">
                    <input id="Quarterly" class="form-control" type="datetime-local" style="margin-right: 20PX;" />
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Semi_annually :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3" style="padding-top: 10px;">
                    <input id="Semiannually" class="form-control" type="datetime-local" style="margin-right:20PX;" />
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Yearly :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3" style="padding-top: 10px;">
                    <input id="Yearly" class="form-control" type="datetime-local" style="margin-right:20PX;" />
                </div>
                <div class="col-md-2 col-sm-2 col-12 mb-3" style="padding-top: 10px;">
                    <div>Manually :</div>
                </div>
                <div class="col-md-4 col-sm-4 col-12 mb-3" style="padding-top: 10px;">
                    <input id="Manually" class="form-control" type="datetime-local" style="margin-right:20PX;" />
                </div>
            </div>
        </div>
    </div>
   
</div>


<div class="col-custom">
<div class="row">
    <div class="col-md-12 col-sm-12 col-12" style="display: flex; justify-content: flex-end; column-gap: 5px; padding-top: 10px;">
        <button class="btn btn-filled" onclick="onSave()">Save</button>
        <button class="btn btn-transparent" onclick="onCancel()">Cancel</button>
    </div>
</div>
</div>

<script>
    var lists = {};
    var editData = {};
    var Equipment_Picture = "";
    $(document).ready(function () {
        var topic = document.getElementById("topic");
        if ("@ViewData["MA_ID"]" != "") {
            topic.textContent = "Edit Equipment";
            $("#Editdate").show();
        }
        else {
            topic.textContent = "Add Equipment";
            $("#Adddate").show();
        }

        loadAllLists();
        $('#Drawing').select2({
            width: '100%',
            minimumInputLength: 3
        });
        $('input[name="Type_MA"]').trigger("change");

    });
    $('#Customer').change(function () {
        var Customer = $(this).val();
        $('#Product_name').val('');
        if (Customer && Customer != "N/A") {
            LoadDrawingByCustomer(Customer);
        }
    });
    $('input[name="Type_MA"]').change(function () {
        console.log("Test");
        var value = $('input[name="Type_MA"]:checked').val();

        if (value === "Tools") {
            $(".Toolvisible").show();
            if ($('input[name="Type_tools"]:checked').val() === "other") {
                $("#req_Description").show();
            } else {
                $("#req_Description").hide();
            }
        } else {
            $(".Toolvisible").hide();
            $("#req_Description").hide();
        }

    });

    $('input[name="Type_tools"]').change(function () {
        var val = $('input[name="Type_tools"]:checked').val();
        if (val === "other") {
            $("#req_Description").show();
            $("#Description").focus();
        } else {
            $("#req_Description").hide();
        }
    });

    $('#Drawing').on('change', function () {
        var Drawing = $(this).val();
        if ($('#Product_name').val() == "") {
            $('#Product_name').val(Drawing);
            LoadCustomerByDrawing(Drawing);
        }
        else {
            $('#Product_name').val($('#Product_name').val() + ',' + Drawing);
        }
    });
    function previewImage(event) {
        const file = event.target.files[0];

        if (file) {
            document.getElementById("file-name-after").innerText = file.name;

            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById("image-preview-after").src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    }

    document.getElementById('Equipment_No').addEventListener('change', function (event) {
        event.preventDefault();
        checkDuplicates({ serialNo: "", Equipment_No: event.target.value, maId: "@ViewData["MA_ID"]" });
    });


    document.getElementById('Serial_No').addEventListener('change', function (event) {
        event.preventDefault();
        checkDuplicates({ serialNo: event.target.value, Equipment_No: "", maId: "@ViewData["MA_ID"]" });
    });

    document.getElementById('Pinnumber').addEventListener('change', function (event) {
        event.preventDefault();
        getInformationFromDatabase(event.target.value)
    });

    function LoadDrawingByCustomer(Customer) {
        console.log('customer', Customer);
        var url = '@Url.Action("Load_Drawing_By_Customer", "Global")';
        $.ajax({
            type: 'POST',
            url: url,
            data: JSON.stringify({ Customer: Customer }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response.success) {
                    $('#Drawing').empty();
                    lists = response.data;
                    console.log('test');
                    $('<option>', {
                        text: 'N/A',
                        value: 'N/A',
                        disabled: true,
                        selected: true
                    }).appendTo('#Drawing');
                    lists.forEach(function (item) {
                        $('<option>', {
                            text: item,
                            value: item
                        }).appendTo('#Drawing');
                    });
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                $('#info-container').html('<p>An error occurred while fetching data. Please try again.</p>');
            }
        });
    }

    function LoadCustomerByDrawing(Drawing) {
        console.log('Drawing', Drawing);
        var url = '@Url.Action("Load_Customer_By_Drawing", "Global")';
        $.ajax({
            type: 'POST',
            url: url,
            data: JSON.stringify({ Drawing: Drawing }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response.success) {
                    lists = response.data;
                    console.log(lists);
                    $('#Customer').val(lists);
                    LoadDrawingByCustomer($('#Customer').val());
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                $('#info-container').html('<p>An error occurred while fetching data. Please try again.</p>');
            }
        });
    }

    function getInformationFromDatabase(P_ID) {
        var url = '@Url.Action("GetInformation", "Global")';
        $.ajax({
            type: 'POST',
            url: url,
            data: JSON.stringify({ ID: P_ID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response.success) {
                    // Populate the information in the info-container div
                    //$('#info-container').html(`<p><strong>Data:</strong> ${response.data}</p>`);
                    document.getElementById("Lifetime").value = response.data.Lifetime; // Assuming `Name` is a field in the Customer object
                } else {
                    //$('#info-container').html(`<p>${response.word}</p>`);
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                $('#info-container').html('<p>An error occurred while fetching data. Please try again.</p>');
            }
        });
    }

    function checkDuplicates(data) {
        var url = '@Url.Action("CheckForDuplicateNames", "Global")';
        var dataJson = JSON.stringify({ serialNo: data.serialNo, Equipment_No: data.Equipment_No, maId: data.maId })

        $.ajax({
            type: 'POST',
            url: url,
            data: dataJson,
