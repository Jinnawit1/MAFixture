                                radioButtonsTypeMA[i].checked = true;
                                break;
                            }
                        }

                        const radioButtonsProperty = document.getElementsByName("Property");
                        for (let i = 0; i < radioButtonsTypeMC.length; i++) {
                            if (radioButtonsProperty[i].value === response.data.Property) {
                                radioButtonsProperty[i].checked = true;
                                break;
                            }

                        }
                        //prevent old version error
                        $("#Customerid").val(response.data.Customer);
                        document.getElementById("Equipment_Name").value = response.data.Equipment_Name;
                        document.getElementById("Equipment_Name_old").value = response.data.Equipment_Name;
                        document.getElementById("Equipment_No").value = response.data.Equipment_No;
                        document.getElementById("Model").value = response.data.Model;
                        document.getElementById("Serial_No").value = response.data.Serial_No;
                        document.getElementById("Referrence_No").value = response.data.Referrence_No;
                        document.getElementById("Responsible_Name").value = response.data.Responsible_Name;
                        document.getElementById("Manufacture").value = response.data.Manufacture;
                        document.getElementById("Product_name").value = response.data.Product_name;
                        document.getElementById("Description").value = response.data.Description;

                        document.getElementById("Daily").value = formatDate(response.data.Plan_Daily, 1);
                        document.getElementById("Weekly").value = formatDate(response.data.Plan_Weekly, 1);
                        document.getElementById("Monthly").value = formatDate(response.data.Plan_Monthly, 1);
                        document.getElementById("Quarterly").value = formatDate(response.data.Plan_Quarterly, 1);
                        document.getElementById("Semiannually").value = formatDate(response.data.Plan_Semi_annually, 1);
                        document.getElementById("Yearly").value = formatDate(response.data.Plan_Yearly, 1);
                        document.getElementById("Manually").value = formatDate(response.data.Plan_Manually, 1);
                        document.getElementById("Pinnumber").value = response.data.P_ID ? response.data.P_ID : "1";
                        getInformationFromDatabase(response.data.P_ID)
                        //document.getElementById("Lifetime").value = response.data.Lifetime;
                        document.getElementById("Location").value = response.data.Location

                        document.getElementById("GPVProcess").value = response.data.GPVProcess ? response.data.GPVProcess : "";
                        document.getElementById("ProcessSide").value =  response.data.GPVProcess ? response.data.ProcessSide : "" ;
                        document.getElementById("WithTopCover").value =  response.data.GPVProcess ? response.data.WithTopCover : "";
                        document.getElementById("WithControlTooling").value =  response.data.GPVProcess ? response.data.WithControlTooling : "";
                        document.getElementById("Grade_Status").value =  response.data.GPVProcess ? response.data.Grade_Status : "";
                        document.getElementById("Dimension").value =  response.data.Dimension ? response.data.Dimension : "" ;

                        var toolVal = response.data.Type_Tools ? response.data.Type_Tools : "";
                        if (toolVal) {
                            if (toolVal === "Selective" || toolVal === "Wave" || toolVal === "Stencill") {
                                $('input[name="Type_tools"][value="' + toolVal + '"]').prop('checked', true);
                            } else {
                                $('input[name="Type_tools"][value="other"]').prop('checked', true);
                            }
                        } else {
                            $('input[name="Type_tools"]').prop('checked', false);
                        }
                        var fileName = response.data.Equipment_Picture;
                        console.log(fileName);
                        console.log(basePath + fileName);
                        if (fileName) {
                            $("#image-preview-after").attr("src", basePath + fileName);
                        } else {
                            $("#image-preview-after").attr("src", "no-image.png");
                        }
                        $('input[name="Type_MA"]').trigger("change");
                        Equipment_Picture = fileName;
                    }
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

    function loadAllLists() {
        var url = '@Url.Action("Load_All_Lists", "Global")';

        $.ajax({
            type: 'POST',
            url: url,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                if (response.success && response.data) {
                    var lists = response.data;
                    
                    var customerHtml = '<option value="N/A" selected="selected">N/A</option>';
                    lists.Customer.forEach(function (item) {
                        customerHtml += '<option value="' + item + '">' + item + '</option>';
                    });
                    document.getElementById("Customer").innerHTML = customerHtml;

                    var departmentHtml = '';
                    lists.Department.forEach(function (item) {
                        departmentHtml += '<option value="' + item.ID + '">' + item.Section + '</option>';
                    });
                    document.getElementById("Department").innerHTML = departmentHtml;

                    var pinnumberHtml = '';
                    lists.Pinnumber.forEach(function (item) {
                        pinnumberHtml += '<option value="' + item.ID + '">' + item.Pinnumber + '</option>';
                    });
                    document.getElementById("Pinnumber").innerHTML = pinnumberHtml;

                    var serialHtml = '';
                    lists.Serial.forEach(function (item) {
                        serialHtml += '<option value="' + item + '"></option>';
                    });
                    document.getElementById("Referrence_No_List").innerHTML = serialHtml;

                    var drawingHtml = '<option value="" disabled="disabled" selected="selected">N/A</option>';
                    lists.Drawing.forEach(function (item) {
                        drawingHtml += '<option value="' + item.Drawing + '">' + item.Drawing + '</option>';
                    });
                    document.getElementById("Drawing").innerHTML = drawingHtml;

                    if ("@ViewData["MA_ID"]") {
                        onLoad();
                    }
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

    function uploadImage(callback) {
        var fileInput = document.getElementById("file-input-after");
        if (fileInput.files.length === 0) {
            callback(Equipment_Picture); // ไม่มีรูป
            return;
        }

        var formData = new FormData();
        formData.append("file", fileInput.files[0]);
        var url = '@Url.Action("UploadImage", "Global")';
        $.ajax({
            url: url,
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                if (res.success) {
                    Equipment_Picture = res.fileName; // 🔥 update global
                    callback(res.fileName);
                } else {
                    showAlert('error', 'Upload failed', function () { });
                }
            },
            error: function () {
                showAlert('error', 'Upload error', function () { });
            }
        });
    }

