                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }
    function onLoad() {
        var url = '@Url.Action("Load_MAFixture_By_ID", "Global")';
        var dataJson = JSON.stringify({ MA_ID: "@ViewData["MA_ID"]", loadFiles: false })

        $.ajax({
            type: 'POST',
            url: url,
            data: dataJson,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                if (response.success) {
                    if (response.data) {
                        editData = response.data;
                        document.getElementById("Department").value = response.data.GE_ID;
                        if (response.data.Customer_Name && response.data.Customer_Name != "N/A") {
                            console.log("onload", response.data.Customer_Name);
                            $("#Customer").val(response.data.Customer_Name);
                            LoadDrawingByCustomer(response.data.Customer_Name);
                        }
                        const radioButtonsTypeMC = document.getElementsByName("Type_MC");
                        for (let i = 0; i < radioButtonsTypeMC.length; i++) {
                            if (radioButtonsTypeMC[i].value === response.data.Type_MC) {
                                radioButtonsTypeMC[i].checked = true;
                                break;
                            }
                        }

                        const radioButtonsTypeMA = document.getElementsByName("Type_MA");
                        for (let i = 0; i < radioButtonsTypeMA.length; i++) {
                            if (radioButtonsTypeMA[i].value === response.data.Type_MA) {
                                radioButtonsTypeMA[i].checked = true;
                                break;
                            }
                        }

                        const radioButtonsProperty = document.getElementsByName("Property");
                        for (let i = 0; i < radioButtonsTypeMC.length; i++) {
                            if (radioButtonsProperty[i].value === response.data.Property) {
                                radioButtonsProperty[i].checked = true;
                                break;
                            }

                        }
                        //prevent old version error
                        $("#Customerid").val(response.data.Customer);
                        document.getElementById("Equipment_Name").value = response.data.Equipment_Name;
                        document.getElementById("Equipment_Name_old").value = response.data.Equipment_Name;
                        document.getElementById("Equipment_No").value = response.data.Equipment_No;
                        document.getElementById("Model").value = response.data.Model;
                        document.getElementById("Serial_No").value = response.data.Serial_No;
                        LoadReferenceEquipment(response.data.GE_ID, response.data.Section, response.data.Referrence_No);
                        document.getElementById("Responsible_Name").value = response.data.Responsible_Name;
                        document.getElementById("Manufacture").value = response.data.Manufacture;
                        document.getElementById("Product_name").value = response.data.Product_name;
                        document.getElementById("Description").value = response.data.Description;

                        document.getElementById("Daily").value = formatDate(response.data.Plan_Daily, 1);
                        document.getElementById("Weekly").value = formatDate(response.data.Plan_Weekly, 1);
                        document.getElementById("Monthly").value = formatDate(response.data.Plan_Monthly, 1);
                        document.getElementById("Quarterly").value = formatDate(response.data.Plan_Quarterly, 1);
                        document.getElementById("Semiannually").value = formatDate(response.data.Plan_Semi_annually, 1);
                        document.getElementById("Yearly").value = formatDate(response.data.Plan_Yearly, 1);
                        document.getElementById("Manually").value = formatDate(response.data.Plan_Manually, 1);
                        var pIdVal = response.data.P_ID ? response.data.P_ID : "";
                        $('#Pinnumber').val(pIdVal).trigger('change');
                        if (pIdVal) {
                            getInformationFromDatabase(pIdVal);
                        }
                        document.getElementById("Location").value = response.data.Location;
                        document.getElementById("QTY").value = (response.data.QTY !== null && response.data.QTY !== undefined) ? response.data.QTY : "";

                        document.getElementById("GPVProcess").value = response.data.GPVProcess ? response.data.GPVProcess : "";
                        document.getElementById("ProcessSide").value =  response.data.GPVProcess ? response.data.ProcessSide : "" ;
                        document.getElementById("WithTopCover").value =  response.data.GPVProcess ? response.data.WithTopCover : "";
                        document.getElementById("WithControlTooling").value =  response.data.GPVProcess ? response.data.WithControlTooling : "";
                        document.getElementById("Grade_Status").value =  response.data.GPVProcess ? response.data.Grade_Status : "";
                        document.getElementById("Dimension").value =  response.data.Dimension ? response.data.Dimension : "" ;

                        var toolVal = response.data.Type_Tools ? response.data.Type_Tools : "";
                        if (toolVal) {
                            if (toolVal === "Selective" || toolVal === "Wave" || toolVal === "Stencill") {
                                $('input[name="Type_tools"][value="' + toolVal + '"]').prop('checked', true);
                            } else {
                                $('input[name="Type_tools"][value="other"]').prop('checked', true);
                            }
                        } else {
                            $('input[name="Type_tools"]').prop('checked', false);
                        }
                        var fileName = response.data.Equipment_Picture;
                        console.log(fileName);
                        console.log(basePath + fileName);
                        if (fileName) {
                            $("#image-preview-after").attr("src", basePath + fileName);
                        } else {
                            $("#image-preview-after").attr("src", "no-image.png");
                        }
                        $('input[name="Type_MA"]').trigger("change");
                        Equipment_Picture = fileName;

                        // โหลด Sparepart ที่ผูกกับ Equipment นี้ตาม Serial_No
                        if (response.data.Serial_No) {
                            LoadLinkedSpareparts(response.data.Serial_No);
                        }
                    }
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

    function LoadLinkedSpareparts(serialNo) {
        if (!serialNo) {
            $("#panel-linked-spareparts").hide();
            return;
        }

        var currentType = $('input[name="Type_MA"]:checked').val();
        if (currentType !== "Equipment/Machine") {
            $("#panel-linked-spareparts").hide();
            return;
        }

        var url = '@Url.Action("Load_Sparepart_by_EquipmentName", "Global")';
        var editUrl = '@Url.Action("NewEquipment", "Global")';

        $.ajax({
            type: 'POST',
            url: url,
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ Serial_No: serialNo }),
            dataType: "json",
            async: true,
            success: function (response) {
                var panel = $("#panel-linked-spareparts");
                var emptyMsg = $("#sparepart-empty-msg");
                var table = $("#table-linked-spareparts");
                var tbody = $("#sparepart-list-body");
                var badge = $("#sparepart-badge");

                tbody.empty();

                if (response.success && response.data && response.data.length > 0) {
                    badge.text(response.data.length);
                    emptyMsg.hide();
                    table.show();

                    for (var i = 0; i < response.data.length; i++) {
                        var item = response.data[i];
                        var serial = item.Serial_No ? item.Serial_No : "-";
                        var name = item.Equipment_Name ? item.Equipment_Name : "-";
                        var pin = item.Pinnumber ? item.Pinnumber : "-";
                        var qty = (item.QTY !== null && item.QTY !== undefined) ? item.QTY : "-";
                        var link = editUrl + "/" + item.MA_ID;

                        var rowHtml = "<tr>" +
                            '<td style="word-break: break-all;" title="' + serial + '">' + serial + "</td>" +
                            '<td style="word-break: break-all;" title="' + name + '">' + name + "</td>" +
                            '<td style="text-align: center;">' + pin + "</td>" +
                            '<td style="text-align: center;">' + qty + "</td>" +
                            '<td style="text-align: center;">' +
                                '<a href="' + link + '" target="_blank" class="btn btn-xs btn-default" style="padding: 1px 5px;" title="View/Edit Spare Part in new tab">' +
                                    '<i class="fas fa-external-link-alt" style="color: #1890ff;"></i>' +
                                "</a>" +
                            "</td>" +
                        "</tr>";

                        tbody.append(rowHtml);
                    }
                } else {
                    badge.text("0");
                    table.hide();
                    emptyMsg.show();
                }

                if ($('input[name="Type_MA"]:checked').val() === "Equipment/Machine") {
                    panel.show();
                }
            },
            error: function () {
                $("#panel-linked-spareparts").hide();
            }
        });
    }

    function LoadReferenceEquipment(geId, section, selectedValue) {
        var url = '@Url.Action("Load_Equipment_Reference", "Global")';
        var dataJson = JSON.stringify({ GE_ID: geId, Section: section });

        $.ajax({
            type: 'POST',
            url: url,
            contentType: "application/json; charset=utf-8",
            data: dataJson,
            dataType: "json",
            async: true,
            success: function (response) {
                var refSelect = $('#Referrence_No');
                refSelect.empty();
                refSelect.append('<option value="">-- Select Reference Equipment --</option>');

                var hasSelected = false;
                if (response.success && response.data) {
                    for (var i = 0; i < response.data.length; i++) {
                        var item = response.data[i];
                        var displayText = item.Serial_No;

                        var isSelected = (selectedValue && selectedValue === item.Serial_No);
                        if (isSelected) {
                            hasSelected = true;
                        }

                        var option = new Option(displayText, item.Serial_No, isSelected, isSelected);
                        refSelect.append(option);
                    }
                }

                // กรณีแก้ไขข้อมูลแล้วมี selectedValue เดิมอยู่ แต่ไม่อยู่ในรายการที่ดึงมา ให้คงค่าเดิมไว้
                if (selectedValue && !hasSelected && selectedValue !== "") {
                    var extraOption = new Option(selectedValue, selectedValue, true, true);
                    refSelect.append(extraOption);
                }

                refSelect.val(selectedValue ? selectedValue : "").trigger('change');
            },
            error: function () {
                var refSelect = $('#Referrence_No');
                refSelect.empty();
                refSelect.append('<option value="">-- Select Reference Equipment --</option>');
                if (selectedValue) {
                    refSelect.append(new Option(selectedValue, selectedValue, true, true));
                    refSelect.val(selectedValue).trigger('change');
                }
            }
        });
    }

