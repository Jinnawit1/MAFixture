    function OnSave() {
        var updateDate = new Date(document.getElementById("Createdate").value);
        var dateTimeNow = new Date();
        var rowCount = $('#tableCheckList tbody tr').length;
        console.log(rowCount);
        if (rowCount <= 0) {
            showAlert("error", "Not Found Maintenance Checklist");
            return;
        }
        if (imageB.length === 0 || imageA.length === 0) {
            showAlert("error", "Please fill out all required fields.", function () { });
            return;
        }
        if (updateDate.getTime() > dateTimeNow.getTime()) {
            showAlert("error", "Maintenance Date Should Not More Than Current Date", function () { });
            return;
        }
 
        var Sparepart = $('#Sparepart_Select').val();
        var MA_ID = [];
        MA_ID.push(data.MA_ID);
        for (var i = 0; i < Sparepart.length; i++) {
            MA_ID.push(Sparepart[i]);
        }
        totalFiles = MA_ID.length;
        completedFiles = 0;

        for (var i = 0; i < MA_ID.length; i++) {
            let filesMA = {
                MA_ID: parseInt(MA_ID[i]),
                Name: "NO FILE", // Set accordingly
                Createdate: document.getElementById("Createdate").value,
                PlanName: document.getElementById("Planning").value,
                Format: 'UPLOAD',
                FilenameBefore: '',
                FilenameAfter: '',
                CreateBy: "@ViewData["EMPLOYEE_ID"]",
                Serial_No: $('#Serial_No').text(),
                MA_Status: $("#MA_Status").val(),
                GradeBefore: $("#GradeBefore").val(),
                GradeAfter: $("#GradeAfter").val(),
                Comment: $("#Comment").val(),
            };

            setTimeout(function () {
                console.log(filesMA);
                Record_FilesMA(filesMA);
                completedFiles++;
            }, i * 1000);
        }
    }

    function Record_MAPlan() {
        formatDateToSave(data);
        var updateDate = document.getElementById("Createdate").value;

        //data.LastMA_date = updateDate;
        switch (document.getElementById("Planning").value) {
            case "Daily":
                data.Plan_Daily = Dateformat(addDays(updateDate, 1));
                break;

            case "Weekly":
                data.Plan_Weekly = Dateformat(addDays(updateDate, 7));
                break;

            case "Monthly":
                data.Plan_Monthly = Dateformat(addDays(updateDate, 30));
                break;

            case "Quarterly":
                data.Plan_Quarterly = Dateformat(addDays(updateDate, 90));
                break;

            case "Semi_annually":
                data.Plan_Semi_annually = Dateformat(addDays(updateDate, 182));
                break;

            case "Yearly":
                data.Plan_Yearly = Dateformat(addDays(updateDate, 365));
                break;
            case "Manually":
                data.Plan_Manually = updateDate;
                break;
        }
        data.UpdateBy = "@ViewData["EMPLOYEE_ID"]";
        data.Grade_Status = $("#GradeAfter").val();
        var url = '@Url.Action("Record_MAPlan", "Global")';
        var dataJson = JSON.stringify({ data: data });

        $.ajax({
            type: 'POST',
            url: url,
            data: dataJson,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                if (response.success) {
                    if (response.data) {
                        Record_Image_Before();
                    }
                } else {
                    $("#upload-wait-overlay").hide();
                    showAlert('error', response.word, function () { });
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

    function Record_FilesMA(data) {
        $("#upload-wait-overlay").show();
        var url = '@Url.Action("Record_FilesMA", "Global")';
        $.ajax({
            url: url, type: "POST", processData: false,
            data: JSON.stringify(data),
            dataType: 'json',
            contentType: "application/json; charset=utf8",
            dataType: "json",
            async: true,
            success: function (response) {
                if (response.success) {
                    fileMAID = response.data.ID;
                    var tableBody = document.querySelector('#tableCheckList tbody');
                    var rows = tableBody.rows;
                    var dataUpdate = [];
                    for (var i = 0; i < rows.length; i++) {
                        var row = rows[i];
                        var cells = row.cells;
                        let detailWithLineBreaks = cells[1].innerHTML.replace(/<br\s*\/?>/g, '\n');
                        let htmlString = detailWithLineBreaks;
                        let parser = new DOMParser();
                        let doc = parser.parseFromString(htmlString, 'text/html');
                        let item = doc.body.textContent || doc.body.innerText;

                        dataUpdate.push({
                            FID: response.data.ID,
                            Checklistdetail: item,
                            Status: (document.getElementById("Status_" + i).classList.contains('fa-check-circle') ? "True" : "False"),
                            Problem: document.getElementById("Problem_" + i).value,
                            Remark: document.getElementById("Remark_" + i).value,
                        });
                    }

                    Record_MAChecklistdetail(dataUpdate);
                }
                else {
                    $("#upload-wait-overlay").hide();
                    showAlert('error', response.word, function () { });
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

