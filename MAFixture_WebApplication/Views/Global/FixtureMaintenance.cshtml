    function updateFileName(bottom) {
        var fileInput = document.getElementById("file-input-" + bottom);
        var fileNameDisplay = document.getElementById("file-name-" + bottom);
        var imagePreviewContainer = document.getElementById('image-preview-container-' + bottom);

        if (fileInput.files.length > 0) {
            var file = fileInput.files[0];
            var fileName = file.name;
            var ext = file.name.split('.').pop().toLowerCase();
            var dateTimeNow = new Date().toISOString().slice(0, 19).replace('T', ' ');

            var allowedTypes = [
                'image/jpeg',
                'image/png',
                'image/heic',
                'image/heif',
                'application/octet-stream'
            ];

            // ฟังก์ชันหลัก: ใช้ไฟล์ (หลัง convert หรือปกติ)
            function processFile(finalFile, finalName) {
                var idImage;
                if (bottom == "before") {
                    idImage = imageB.length;
                    imageB.push({
                        ID: idImage,
                        Image_Name: finalName,
                        File: finalFile,
                        Date: dateTimeNow
                    });
                    fileNameDisplay.textContent = (idImage + 1) + " selected";
                } else {
                    idImage = imageA.length;
                    imageA.push({
                        ID: idImage,
                        Image_Name: finalName,
                        File: finalFile,
                        Date: dateTimeNow
                    });
                    fileNameDisplay.textContent = (idImage + 1) + " selected";
                }

                // Preview
                var reader = new FileReader();
                reader.onload = function (e) {
                    var previewWrapper = document.createElement('div');
                    previewWrapper.classList.add('image-preview-wrapper');

                    var imagePreview = document.createElement('img');
                    imagePreview.classList.add('image-preview');
                    imagePreview.src = e.target.result;

                    var imageName = document.createElement('span');
                    imageName.classList.add('image-name');
                    imageName.textContent = finalName;

                    var crossIcon = document.createElement('span');
                    crossIcon.textContent = '×';
                    crossIcon.classList.add('cross-icon');

                    crossIcon.onclick = function () {
                        previewWrapper.remove();
                        if (bottom == "before") {
                            var newImageB = [];
                            for (var i = 0; i < imageB.length; i++) {
                                if (imageB[i].ID !== idImage) {
                                    newImageB.push(imageB[i]);
                                }
                            }
                            imageB = newImageB;
                            fileNameDisplay.textContent = imageB.length == 0 ? "No file selected" : ((imageB.length) + " selected");
                        } else {
                            var newImageA = [];
                            for (var i = 0; i < imageA.length; i++) {
                                if (imageA[i].ID !== idImage) {
                                    newImageA.push(imageA[i]);
                                }
                            }
                            imageA = newImageA;
                            fileNameDisplay.textContent = imageA.length == 0 ? "No file selected" : ((imageA.length) + " selected");
                        }
                    };

                    previewWrapper.appendChild(imagePreview);
                    previewWrapper.appendChild(imageName);
                    previewWrapper.appendChild(crossIcon);

                    imagePreviewContainer.appendChild(previewWrapper);
                    imagePreviewContainer.style.display = 'flex';
                };
                reader.readAsDataURL(finalFile);
            }

            // ถ้าเป็น HEIC/HEIF → แปลงก่อน
            if (ext === "heic" || ext === "heif") {
                $("#upload-wait-overlay").show();

                heic2any({ blob: file, toType: "image/jpeg" })
                    .then(function (resultBlob) {
                        var jpegFile = new File([resultBlob], fileName.replace(/\.heic$|\.heif$/i, ".jpg"), {
                            type: "image/jpeg"
                        });
                        $("#upload-wait-overlay").hide();
                        console.log("✅ Converted to JPEG:", jpegFile);
                        processFile(jpegFile, jpegFile.name); // ใช้ไฟล์ใหม่แทน
                    })
                    .catch(function (err) {
                        $("#upload-wait-overlay").hide();
                        console.error("❌ HEIC convert error:", err);
                        showAlert('error', 'Cannot convert HEIC file.', function () { });
                    });
            } else {
                // ไฟล์ทั่วไป (jpeg, png)
                if (allowedTypes.indexOf(file.type) !== -1) {
                    processFile(file, fileName);
                } else {
                    showAlert('error', 'Please select a valid image file (HEIC, JPEG, JPG, or PNG).', function () { });
                    fileInput.value = '';
                    fileNameDisplay.textContent = "No file selected";
                    imagePreviewContainer.style.display = 'none';
                }
            }
        }
    }
