@{
    ViewBag.Title = "Fixture Maintenance";
}

<style>
    .image-preview-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        column-gap: 5px;
        padding: 3px 5px;
        margin-top: 3px;
        border: solid 1px #1890ff;
        background-color: white;
        border-radius: 6px;
    }

    .image-preview {
        width: 20px;
        height: 20px;
        object-fit: cover;
    }

    .image-name {
        display: block;
        font-size: 11px;
        text-align: center;
    }

    .cross-icon {
        cursor: pointer;
        font-size: 20px;
        font-weight: bold;
    }
</style>

