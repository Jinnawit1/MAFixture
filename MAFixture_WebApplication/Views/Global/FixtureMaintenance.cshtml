<script type="text/javascript">
    var data = {};
    var videoStatus = true;
    var videoInputDevicesStatus = false;
    var imageB = [];
    var imageA = [];
    var fileMAID = 0;
    var totalFiles = 0;
    var completedFiles = 0;
    $(document).ready(function () {
        $("#Sparepart_Select").select2();
        const url = new URL(window.location.href);
        if (
                url.searchParams.has('Serial_No') &&
                url.searchParams.has('Equipment_Name')
            ) {
            const serialNo = url.searchParams.get('Serial_No');
            const equipmentName = url.searchParams.get('Equipment_Name');
            $('#Serial_No_Input').val(serialNo);
            checkSerial(serialNo, equipmentName);
        }
        var selectedDeviceId;
        document.getElementById('video').style.display = "none";
        var codeReader = new ZXing.BrowserMultiFormatReader();

        // List video input devices (cameras)
        codeReader.listVideoInputDevices()
            .then(function (videoInputDevices) {
                console.log("videoInputDevices", videoInputDevices);
                var sourceSelect = document.getElementById('sourceSelect');
                selectedDeviceId = videoInputDevices[0].deviceId;

                // Populate the sourceSelect dropdown with available camera devices
                if (videoInputDevices.length >= 1) {
                    videoInputDevicesStatus = true;
                    videoInputDevices.forEach(function (element) {
                        var sourceOption = document.createElement('option');
                        sourceOption.text = element.label;
                        sourceOption.value = element.deviceId;
                        sourceSelect.appendChild(sourceOption);
                    });

                    // Update the selected device when the dropdown changes
                    sourceSelect.onchange = function () {
                        selectedDeviceId = sourceSelect.value;
                        // yok
                        codeReader.reset(); // ปิดกล้องเดิมก่อน
                        toggleCodeReader(codeReader, selectedDeviceId); // เริ่มกล้องใหม่ตามที่เลือก
                    };

                    // Show the source selection dropdown if more than one camera is available
                    var sourceSelectPanel = document.getElementById('sourceSelectPanel');
                    sourceSelectPanel.style.display = 'block';
                }

                // Start scanning when the "Start" button is clicked
                document.getElementById('startButton').addEventListener('click', function () {
                    event.preventDefault();
                    toggleCodeReader(codeReader, selectedDeviceId);
                });

                document.getElementById('sourceSelect').addEventListener('change', function () {
                    videoStatus = true;
                    document.getElementById('startButton').click();
                });

            })
            .catch(function (err) {
                //showAlert('error', err, function () { });
            });

    });


    document.getElementById("Serial_No_Input").addEventListener("keydown", function (event) {
        if (event.key === "Enter") {
            event.preventDefault();
            checkSerial(event.target.value);
        }
    });

    function checkserialByID(MA_ID) {
        OnCancel();
        console.log(imageA);
        console.log(imageB);
        data = {};
        var url = '@Url.Action("Load_MAFixture_By_ID", "Global")';
        var dataJson = JSON.stringify({ MA_ID: MA_ID })

        $.ajax({
            type: 'POST',
            url: url,
            data: dataJson,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                document.getElementById('video-message').textContent = "Point the camera at the barcode.";
                document.getElementById('video-message').style.backgroundColor = '#fffbe6';
                document.getElementById('video-message').style.borderColor = '#ffe58f';
                if (response.success) {
                    if (response.data) {
                        //prevent json too large
                        response.data.filesMA = [];
                        document.getElementById("Equipment_Name_Select").innerHTML = '';
                        document.getElementById("equipmentNameSelectDiv").style.display = "none";
                        setFixtureInfo(response.data);
                        //fetchCustomerName(response.data.Customer);
                        document.getElementById("Customer").textContent = response.data.Customer_Name;
                    }
                } else {
                    showAlert('error', 'Serial number is not found.', function () { });
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }



    function checkSerial(Serial_No, Equipment_Name) {
        OnCancel();
        console.log(imageA);
        console.log(imageB);
        data = {};
        var url = '@Url.Action("Load_MAFixture_By_Serial", "Global")';
        var dataJson = JSON.stringify({ Serial_No: Serial_No })

        $.ajax({
            type: 'POST',
            url: url,
            data: dataJson,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                document.getElementById('video-message').textContent = "Point the camera at the barcode.";
                document.getElementById('video-message').style.backgroundColor = '#fffbe6';
                document.getElementById('video-message').style.borderColor = '#ffe58f';
                if (response.success) {
                    if (response.data) {
                        //prevent json too large
                        response.data[0].FilesMAs = [];
                        document.getElementById("Equipment_Name_Select").innerHTML = '';
                        document.getElementById("equipmentNameSelectDiv").style.display = "none";
                        if (response.data.length == 1) {
                            setFixtureInfo(response.data[0]);
                            //fetchCustomerName(response.data[0].Customer);
                            document.getElementById("Customer").textContent = response.data[0].Customer_Name;
                        } else {
                            document.getElementById("equipmentNameSelectDiv").style.display = "block";
                            equipmentName = response.data;
                            var defaultOption = document.createElement("option");
                            defaultOption.text = "Select Equipment";
                            defaultOption.value = "";
                            defaultOption.disabled = true;
                            defaultOption.selected = true;
                            document.getElementById("Equipment_Name_Select").appendChild(defaultOption);

                            equipmentName.forEach(function (item, index) {
                                var option = document.createElement("option");
                                option.text = item.Equipment_Name;
                                option.value = item.MA_ID;
                                document.getElementById("Equipment_Name_Select").appendChild(option);
                            });
                            if (Equipment_Name) {
                                $('#Equipment_Name_Select option').filter(function () {
                                    return $(this).text() === Equipment_Name;
                                }).prop('selected', true);
                                checkserialByID($('#Equipment_Name_Select').val());
                            }
                            else {
                                document.getElementById("Equipment_Name_Select").addEventListener("change", function (event) {
                                    checkserialByID(event.target.value);
                                });
                            }

                        }


                    }
                } else {
                    showAlert('error', 'Serial number is not found.', function () { });
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

    function setFixtureInfo(dataInfo) {
        var form = document.getElementById("update-form");
        videoStatus = false;
        document.getElementById('startButton').click();
        data = dataInfo;
        form.style.display = "block";
        document.getElementById("Serial_No").textContent = dataInfo.Serial_No;
        document.getElementById("Section").textContent = dataInfo.Section;
        document.getElementById("LastMA_date").textContent = formatDate(dataInfo.LastMA_date, 2);
        let productName = data.Product_name ? data.Product_name : "";
        let items = productName.split(",");

        if (items.length > 2) {
            document.getElementById("Product_name").textContent = items.slice(0, 2).join(", ") + " And More";
        } else {
            document.getElementById("Product_name").textContent = productName;
        }
        document.getElementById("Equipment_No").textContent = dataInfo.Equipment_No;
        document.getElementById("Equipment_Name").textContent = dataInfo.Equipment_Name;
        document.getElementById("Type_MC").textContent = dataInfo.Type_MC;
        document.getElementById("Customer").textContent = dataInfo.Customer;
        document.getElementById("Section").textContent = dataInfo.Section;
        document.getElementById("Property").textContent = dataInfo.Property;
        document.getElementById("Responsible_Name").textContent = dataInfo.Responsible_Name;
        document.getElementById("Description").textContent = dataInfo.Description;
        document.getElementById("Model").textContent = dataInfo.Model;
        document.getElementById("Referrence_No").textContent = dataInfo.Referrence_No;
        document.getElementById("Manufacture").textContent = dataInfo.Manufacture;

