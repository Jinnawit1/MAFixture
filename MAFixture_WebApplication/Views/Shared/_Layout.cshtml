        </div>
    </div>

    <!-- Footer -->
    <div class="footer">
        <hr />
        <footer style="display: inline-flexbox; font-size: 9px; padding-left: 5px; padding-bottom: 1px;">
            <p><i class="fas fa-code-branch"></i> 1.0.0 &copy; 2024 R&D Electronics Production, GPV-Asia(Thailand) Co.,Ltd. Samutprakarn, Thailand.</p>
        </footer>
