        <span id="alert-error-text"></span>
    </div>

    <!-- Navbar (Top Menu) -->
    <nav class="navbar">
        <div class="navbar-logo"><img src="~/Images/GPV_Logo.png" alt="GPV_Logo" class="img-rounded" style="width: 95px; height: 45px; padding: 10px;"></div>
        <ul class="navbar-links">
            <li><a href="@Url.Action("Index", "Global")">Home</a></li>
            <li><a href="@Url.Action("MaintenanceHistory", "Global")" id="MaintenanceHistory">MA History</a></li>
            <li class="dropdown">
                <a href="#" class="dropdown-toggle" data-toggle="dropdown">Fixture<span class="caret"></span></a>
                <ul class="dropdown-menu">
                    <li><a href="@Url.Action("NewEquipment", "Global")">New Equipment</a></li>
                    <li><a href="@Url.Action("FixtureMaintenance", "Global")">Fixture Maintenance</a></li>
                    <li><a href="@Url.Action("ObsoleteFixture", "Global")">Obsolete Fixture</a></li>
