            /* Checkbox label style to look like Ant Design */
            .checkbox-group label {
                display: flex;
                align-items: center;
                cursor: pointer;
                font-size: 12px;
                font-weight: 400;
            }

            /* Style the actual checkboxes */
            .checkbox-group input[type="checkbox"] {
                appearance: none; /* Remove default checkbox appearance */
                width: 18px;
                height: 18px;
                border-radius: 4px;
                border: 2px solid #d9d9d9;
                background-color: #fff;
                margin-right: 8px;
                position: relative;
