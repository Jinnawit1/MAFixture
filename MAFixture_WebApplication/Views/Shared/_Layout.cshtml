    <!-- Login -->
    <div class="modal fade" id="myModalLogIn" tabindex="-1" role="dialog" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog" style="width: 350px;" role="document">
            <div class="modal-content" style="border-radius: 8px; border: none; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);">
