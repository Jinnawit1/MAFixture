@using System.Web.Optimization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MA Fixture</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap4")

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .progress-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: #222;
            color: white;
            padding: 20px 40px;
            border-radius: 8px;
            font-size: 18px;
            font-weight: bold;
            box-shadow: 0 0 15px rgba(0,0,0,0.7);
            text-align: center;
        }

        .progress-main {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5); /* semi-transparent background */
            z-index: 9999;
            cursor: wait;
        }

        .navbar {
            position: fixed;
            top: 0;
            z-index: 50;
            display: flex;
            align-items: center;
            padding: 10px 20px;
            background-color: #f0f2f5;
            color: #001529;
            transition: top 0.3s ease; /* Smooth transition when top changes */
        }

        .navbar-logo {
            font-weight: bold;
            color: #001529;
            display: flex;
            align-items: center;
        }

        .navbar-links {
            display: flex;
            list-style-type: none;
            margin-left: 20px;
        }

            .navbar-links li {
                margin: 0 10px;
                padding-top: 10px;
            }

            .navbar-links a {
                color: #001529;
                text-decoration: none;
                font-size: 14px;
                padding: 10px;
                transition: color 0.3s;
            }

                .navbar-links a:hover {
                    color: #1890ff;
                }

        .navbar-actions {
            display: flex;
            gap: 10px;
            margin-left: auto;
        }

        /* Style for the dropdown */
        .navbar-links .dropdown {
            position: relative;
        }

        /* Style the dropdown menu */
        .navbar-links .dropdown-menu {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            min-width: 160px;
            list-style: none;
            background-color: #fff;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            z-index: 1000;
            padding: 5px 0;
            margin: 0;
        }

        /* Show the dropdown menu on hover */
        .navbar-links .dropdown:hover .dropdown-menu {
            display: block;
        }

        /* Style for the dropdown items */
        .navbar-links .dropdown-menu li {
            padding: 8px 16px;
        }

            /* Hover effect for dropdown items */
            .navbar-links .dropdown-menu li:hover {
                background-color: #f1f1f1;
            }

            .navbar-links .dropdown-menu li a:hover {
                background-color: transparent; /* Remove the background */
                color: #333; /* Optional: customize text color on hover */
            }

            /* Optional: Remove focus effect if needed (for accessibility) */
            .navbar-links .dropdown-menu li a:focus {
                outline: none; /* Remove focus outline */
                background-color: transparent; /* Remove background color on focus */
            }

        .btn {
            padding: 7px 14px;
            font-size: 12px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .btn-transparent {
            background-color: transparent;
            color: #1890ff;
            border: 1px solid #1890ff;
        }

            .btn-transparent:hover {
                background-color: #1890ff;
                color: white;
            }

        .btn-filled {
            background-color: #1890ff;
            color: white;
        }

            .btn-filled:hover {
                background-color: #40a9ff;
            }

            .btn-transparent:focus, .btn-filled:focus,
            .btn-transparent:active, .btn-filled:active {
                outline: none !important;
                color: inherit !important;
            }

        .content {
            margin-top: 70px;
            min-height: calc(100vh - 140px);
            padding: 0px 20px;
            font-size: 14px;
        }

        .alert {
            display: none;
            align-items: center;
            justify-content: center;
            padding: 10px 20px;
            border-radius: 4px;
            margin: 10px 0;
            transition: all 0.3s ease;
            position: fixed;
            top: 5px;
            right: 10px;
            z-index: 1000;
        }

        .alert-success {
            background-color: #f6ffed;
            border: 1px solid #b7eb8f;
            color: #389e0d;
        }

        .alert-error {
            background-color: #fff2f0;
            border: 1px solid #ffccc7;
            color: #f5222d;
        }

        .show {
            display: flex;
        }

        .alert span {
            font-size: 12px;
            font-weight: 500;
        }

        table.dataTable thead th {
            margin-top: 0 !important;
            margin-bottom: 0 !important;
        }


        table.dataTable {
            margin-top: 0 !important;
        }

            table.dataTable tbody td, table.dataTable > thead > tr > th {
                padding: 5px 5px;
            }

        .dataTables_length {
            margin-left: 10px;
        }

            .dataTables_length label {
                font-weight: bold;
                margin-right: 5px;
            }

            .dataTables_length select {
                border-radius: 6px;
                padding: 5px;
                background-color: whitesmoke;
                border: 1px solid #ccc;
                cursor: pointer;
            }

        table tr {
            vertical-align: top;
        }

        table thead {
            background-color: whitesmoke;
        }

        .dt-buttons {
            margin: 0px !important;
            display: flex;
            justify-content: flex-start;
        }

            .dt-buttons .dt-button {
                min-width: 60px;
                background-color: #1890ff;
                color: white;
                padding: 8px 12px;
                font-size: 12px;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                transition: background-color 0.3s;
            }

                .dt-buttons .dt-button:hover {
                    background-color: #40a9ff !important;
                    color: black;
                    font-size: 12px;
                    border: none;
                    border-radius: 4px;
                    cursor: pointer;
                    padding: 8px 12px;
                    border: none !important;
                }

        .dataTables_filter {
            margin: 10px 0;
            display: flex;
            align-items: center;
        }

            .dataTables_filter input[type="search"] {
                border: 1px solid #ccc;
                border-radius: 6px;
                background-color: whitesmoke;
                padding: 8px;
                margin-left: 10px;
                width: 250px;
                transition: border-color 0.3s;
            }

                .dataTables_filter input[type="search"]:focus {
                    outline: none;
                }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            padding: 5px 10px;
            margin: 0 5px;
            border-radius: 6px;
            background-color: whitesmoke !important;
            font-weight: normal;
            cursor: pointer;
            transition: background-color 0.3s, color 0.3s;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button.current {
                background-color: lightgray !important;
                color: white;
                cursor: pointer;
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
                color: gray;
                background-color: lightgray;
                border-color: lightgray;
                cursor: not-allowed;
            }

        .form-control {
            border-radius: 6px;
            margin: 3px 0px;
            /*padding: 10px 10px;*/
            width: 100%;
            font-size: 12px;
            border: 1px solid #d9d9d9;
            outline: none;
            background-color: whitesmoke;
        }

        select.ant-select {
            width: 100%;
            padding: 8px 6px;
            margin: 3px 0px;
            border: 1px solid #d9d9d9;
            border-radius: 6px;
            background-color: whitesmoke;
            font-size: 12px;
            color: #595959;
            box-sizing: border-box;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            select.ant-select:focus {
                border-color: #40a9ff;
                outline: none;
                box-shadow: 0 0 0 2px rgba(24, 144, 255, 0.2);
            }

            select.ant-select option {
                padding: 8px;
                background-color: #fff;
                color: #000;
            }

                select.ant-select option:hover {
                    background-color: #f0f0f0;
                }

            select.ant-select:disabled {
                background-color: #f5f5f5;
                border-color: #d9d9d9;
                color: #bfbfbf;
            }

        .select2-container--default .select2-selection--single {
            background-color: whitesmoke;
            border: 1px solid #ccc;
        }
        /* The container */
        .container {
            display: block;
            width: 100%;
            position: relative;
            padding-left: 35px;
            margin-bottom: 12px;
            cursor: pointer;
            font-size: 12px;
            font-weight: normal;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }

            /* Hide the browser's default radio button */
            .container input {
                position: absolute;
                opacity: 0;
                cursor: pointer;
            }

        /* Create a custom radio button */
        .checkmark {
            position: absolute;
            top: 0;
            left: 0;
            height: 20px;
            width: 20px;
            background-color: #eee;
            border-radius: 50%;
        }

        /* On mouse-over, add a grey background color */
        .container:hover input ~ .checkmark {
            background-color: #ccc;
        }

        /* When the radio button is checked, add a blue background */
        .container input:checked ~ .checkmark {
            background-color: #1890ff;
        }

        /* Create the indicator (the dot/circle - hidden when not checked) */
        .checkmark:after {
            content: "";
            position: absolute;
            display: none;
        }

        /* Show the indicator (dot/circle) when checked */
        .container input:checked ~ .checkmark:after {
            display: block;
        }

        /* Style the indicator (dot/circle) */
        .container .checkmark:after {
            top: 6px;
            left: 6px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: white;
        }

        textarea {
            resize: vertical;
            margin-bottom: 3px;
        }

        .input-file-container {
            display: flex;
            flex-direction: column;
            border: 1px solid #d9d9d9;
            padding: 20px;
            background-color: whitesmoke;
            border-radius: 8px;
        }

        label {
            margin-bottom: 8px;
            font-size: 12px;
            color: #595959;
        }

        .file-input {
            display: none;
        }

        .file-label {
            display: inline-block;
            padding: 10px 20px;
            font-size: 12px;
            color: #1890ff;
            background-color: #fff;
            border: 1px solid #d9d9d9;
            border-radius: 4px;
            cursor: pointer;
            text-align: center;
            transition: all 0.3s ease;
        }

            .file-label:hover {
                background-color: #1890ff;
                border-color: #1890ff;
                color: white;
            }

            .file-label:active {
                background-color: #40a9ff;
                border-color: #1890ff;
            }

            .file-label span {
                margin-left: 8px;
            }

        .file-name {
            margin-top: 10px;
            font-size: 12px;
            color: #595959;
            word-wrap: break-word;
        }

        .confirm-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        .confirm-modal-content {
            background-color: white;
            padding: 20px;
            border-radius: 5px;
            text-align: center;
            width: 300px;
        }

        .confirm-modal-actions {
            margin-top: 20px;
        }

        .checkbox-group {
            display: flex;
            flex-direction: row;
            gap: 10px;
        }

            /* Checkbox label style to look like Ant Design */
            .checkbox-group label {
                display: flex;
                align-items: center;
                cursor: pointer;
                font-size: 12px;
                font-weight: 400;
            }

            /* Style the actual checkboxes */
            .checkbox-group input[type="checkbox"] {
                appearance: none; /* Remove default checkbox appearance */
                width: 18px;
                height: 18px;
                border-radius: 4px;
                border: 2px solid #d9d9d9;
                background-color: #fff;
                margin-right: 8px;
                position: relative;
                transition: all 0.2s ease;
                cursor: pointer;
            }

                /* When checkbox is checked, add background and border */
                .checkbox-group input[type="checkbox"]:checked {
                    background-color: #1890ff;
                    border-color: #1890ff;
                }

                    /* Add a checkmark inside the box when checked */
                    .checkbox-group input[type="checkbox"]:checked::before {
                        content: '';
                        position: absolute;
                        top: 1px;
                        left: 4px;
                        width: 6px;
                        height: 10px;
                        border: solid white;
                        border-width: 0 3px 3px 0;
                        transform: rotate(45deg);
                    }

                /* Hover effect for checkboxes */
                .checkbox-group input[type="checkbox"]:hover {
                    border-color: #1890ff;
                }

                .checkbox-group input[type="checkbox"]:focus {
                    outline: none; /* Remove the focus outline */
                }

        body.modal-open {
            overflow: hidden !important;
            position: fixed;
            width: 100%;
        }

        #TableMAPlan th.product-col,
        #TableMAPlan td.product-col {
            min-width: 300px !important;
            max-width: 300px !important;
        }

        #TableMAPlan th.description-col,
        #TableMAPlan td.description-col {
            min-width: 300px !important;
            max-width: 300px !important;
        }
    </style>
</head>
<body>
