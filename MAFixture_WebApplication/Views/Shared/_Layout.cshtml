                    /* Add a checkmark inside the box when checked */
                    .checkbox-group input[type="checkbox"]:checked::before {
                        content: '';
                        position: absolute;
                        top: 1px;
                        left: 4px;
                        width: 6px;
                        height: 10px;
                        border: solid white;
