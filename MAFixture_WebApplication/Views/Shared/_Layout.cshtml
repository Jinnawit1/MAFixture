@using System.Web.Optimization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MA Fixture</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap4")

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .progress-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: #222;
            color: white;
            padding: 20px 40px;
            border-radius: 8px;
            font-size: 18px;
            font-weight: bold;
            box-shadow: 0 0 15px rgba(0,0,0,0.7);
            text-align: center;
        }

        .progress-main {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5); /* semi-transparent background */
            z-index: 9999;
            cursor: wait;
        }

        /* ==========================================================================
           Modern Top Navbar (Clean Light Theme)
           ========================================================================== */
        .navbar {
            position: sticky;
            top: 0;
            left: 0;
            width: 100%;
            min-width: 100%;
            height: 60px;
            z-index: 1030;
            display: flex;
            align-items: center;
            padding: 0 20px;
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
            transition: top 0.3s ease;
        }

        .navbar-logo {
            display: flex;
            align-items: center;
            padding-right: 14px;
            margin-right: 12px;
            border-right: 1px solid #e2e8f0;
            height: 38px;
            flex-shrink: 0;
        }

        .navbar-logo img {
            height: 36px;
            width: auto;
            object-fit: contain;
            display: block;
        }

        .navbar-links {
            display: flex;
            align-items: center;
            list-style-type: none;
            margin: 0;
            padding: 0;
            gap: 2px;
        }

        .navbar-links > li {
            position: relative;
            margin: 0;
            padding: 0;
        }

        .navbar-links > li > a {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 11px;
            border-radius: 6px;
            color: #475569;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .navbar-links > li > a:hover {
            color: #1890ff;
            background-color: #f1f5f9;
            text-decoration: none;
        }

        /* Active Navigation Item */
        .navbar-links > li > a.active,
        .navbar-links > li.dropdown.active > a.dropdown-toggle {
            color: #1890ff !important;
            background-color: #e6f4ff !important;
            font-weight: 600;
        }

        /* Dropdown Arrow / Chevron */
        .navbar-links .dropdown-toggle .nav-chevron {
            font-size: 10px;
            margin-left: 3px;
            transition: transform 0.2s ease;
            color: #94a3b8;
        }

        .navbar-links .dropdown:hover .dropdown-toggle .nav-chevron {
            transform: rotate(180deg);
            color: #1890ff;
        }

        /* Style the dropdown menu */
        .navbar-links .dropdown-menu {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            min-width: 190px;
            list-style: none;
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
            z-index: 1050;
            padding: 5px;
            margin-top: 4px;
        }

        /* Show the dropdown menu on hover */
        .navbar-links .dropdown:hover .dropdown-menu {
            display: block;
        }

        /* Style for the dropdown items */
        .navbar-links .dropdown-menu li {
            padding: 0;
            margin: 0;
        }

        .navbar-links .dropdown-menu li a {
            display: flex;
            align-items: center;
            padding: 8px 14px;
            font-size: 13px;
            font-weight: 500;
            color: #334155;
            text-decoration: none;
            border-radius: 5px;
            transition: all 0.15s ease;
        }

        .navbar-links .dropdown-menu li a:hover {
            background-color: #f1f5f9;
            color: #1890ff;
            padding-left: 17px;
            text-decoration: none;
        }

        .navbar-links .dropdown-menu li a.active {
            background-color: #e6f4ff;
            color: #1890ff;
            font-weight: 600;
        }

        .navbar-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-left: auto;
            flex-shrink: 0;
        }

        .navbar-user-chip {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 5px 12px;
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            font-size: 12px;
            color: #334155;
            font-weight: 500;
        }

        .navbar-user-chip i {
            font-size: 15px;
            color: #1890ff;
        }

        .btn-nav-signin {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: 500;
            color: #ffffff !important;
            background-color: #1890ff;
            border: 1px solid #1890ff;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-nav-signin:hover {
            background-color: #40a9ff;
            border-color: #40a9ff;
        }

        .btn-nav-signout {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: 500;
            color: #64748b !important;
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-nav-signout:hover {
            color: #ef4444 !important;
            background-color: #fef2f2;
            border-color: #fca5a5;
        }

        .btn {
            padding: 7px 14px;
            font-size: 12px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .btn-transparent {
            background-color: transparent;
            color: #1890ff;
            border: 1px solid #1890ff;
        }

            .btn-transparent:hover {
                background-color: #1890ff;
                color: white;
            }

        .btn-filled {
            background-color: #1890ff;
            color: white;
        }

            .btn-filled:hover {
                background-color: #40a9ff;
            }

            .btn-transparent:focus, .btn-filled:focus,
            .btn-transparent:active, .btn-filled:active {
                outline: none !important;
                color: inherit !important;
            }

        .content {
            margin-top: 15px;
            min-height: calc(100vh - 140px);
            padding: 0px 20px;
            font-size: 14px;
        }

        .alert {
            display: none;
            align-items: center;
            justify-content: flex-start;
            padding: 12px 18px;
            border-radius: 6px;
            position: fixed;
            top: 70px;
            right: 20px;
            z-index: 100000;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
            min-width: 280px;
            max-width: 480px;
            word-wrap: break-word;
            gap: 10px;
            transition: all 0.25s ease-in-out;
        }

        .alert-success {
            background-color: #f6ffed;
            border: 1px solid #b7eb8f;
            color: #389e0d;
        }

        .alert-error {
            background-color: #fff2f0;
            border: 1px solid #ffccc7;
            color: #f5222d;
        }

        .alert.show {
            display: flex !important;
        }

        .alert span {
            font-size: 13px;
            font-weight: 500;
            line-height: 1.4;
            flex-grow: 1;
        }

        .alert i {
            font-size: 16px;
            flex-shrink: 0;
        }

        /* ==========================================================================
           Modern Corporate DataTables Styling
           ========================================================================== */
        table.dataTable {
            width: 100% !important;
            border-collapse: separate !important;
            border-spacing: 0;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            overflow: hidden;
            background-color: #ffffff;
            margin-top: 10px !important;
            margin-bottom: 16px !important;
        }

        table.dataTable thead {
            background-color: #f8fafc;
        }

        table.dataTable thead th {
            padding: 10px 12px !important;
            font-size: 12.5px;
            font-weight: 600;
            color: #334155;
            border-top: none !important;
            border-bottom: 2px solid #cbd5e1 !important;
            border-left: none !important;
            border-right: 1px solid #f1f5f9 !important;
            white-space: nowrap;
            vertical-align: middle;
        }

        table.dataTable thead th:last-child {
            border-right: none !important;
        }

        /* Prevent duplicate header in DataTables scroll body if scrollX/scrollY is used */
        .dataTables_scrollBody table.dataTable thead th,
        .dataTables_scrollBody table.dataTable thead td {
            padding: 0 !important;
            border: none !important;
            height: 0 !important;
            line-height: 0 !important;
            margin: 0 !important;
            color: transparent !important;
        }

        .dataTables_scrollBody table.dataTable thead tr {
            height: 0 !important;
        }

        .dataTables_scrollBody table.dataTable {
            margin-top: 0 !important;
        }

        table.dataTable tbody td {
            padding: 8px 12px !important;
            font-size: 13px;
            color: #1e293b;
            border-top: none !important;
            border-bottom: 1px solid #f1f5f9 !important;
            border-left: none !important;
            border-right: 1px solid #f8fafc !important;
            vertical-align: middle;
            transition: background-color 0.15s ease;
        }

        table.dataTable tbody tr:hover {
            background-color: #f8fafc !important;
        }

        table.dataTable tbody tr.shown {
            background-color: #eff6ff !important;
        }

        table.dataTable tbody tr.shown-child {
            background-color: #f8fafc !important;
        }

        .dataTables_wrapper {
            padding: 4px 0;
        }

        .dataTables_length {
            margin-bottom: 10px;
            display: inline-flex;
            align-items: center;
        }

        .dataTables_length label {
            font-size: 12.5px;
            font-weight: 500;
            color: #475569;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 0;
        }

        .dataTables_length select {
            height: 32px;
            border-radius: 6px;
            padding: 4px 8px;
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            color: #334155;
            font-size: 12.5px;
            font-weight: 500;
            cursor: pointer;
            outline: none;
            transition: border-color 0.2s;
        }

        .dataTables_length select:focus {
            border-color: #1890ff;
        }

        .dataTables_filter {
            margin-bottom: 10px;
            float: right;
            display: inline-flex;
            align-items: center;
        }

        .dataTables_filter label {
            font-size: 12.5px;
            font-weight: 500;
            color: #475569;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 0;
        }

        .dataTables_filter input[type="search"] {
            height: 32px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            background-color: #ffffff;
            padding: 4px 10px;
            width: 220px;
            font-size: 12.5px;
            color: #1e293b;
            outline: none;
            transition: all 0.2s ease;
        }

        .dataTables_filter input[type="search"]:focus {
            border-color: #1890ff;
            box-shadow: 0 0 0 2px rgba(24, 144, 255, 0.15);
        }

        .dt-buttons {
            margin-bottom: 10px !important;
            display: inline-flex;
            gap: 6px;
        }

        .dt-buttons .dt-button {
            height: 32px;
            padding: 0 14px;
            font-size: 12.5px;
            font-weight: 500;
            border-radius: 6px;
            background-color: #ffffff !important;
            border: 1px solid #cbd5e1 !important;
            color: #15803d !important;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .dt-buttons .dt-button:hover {
            background-color: #f0fdf4 !important;
            border-color: #86efac !important;
            color: #166534 !important;
        }

        .dataTables_info {
            font-size: 12.5px;
            color: #64748b;
            padding-top: 8px;
            display: inline-block;
        }

        .dataTables_wrapper .dataTables_paginate {
            padding-top: 8px;
            float: right;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            padding: 4px 11px !important;
            font-size: 12.5px !important;
            font-weight: 500 !important;
            border-radius: 6px !important;
            background: #ffffff !important;
            border: 1px solid #cbd5e1 !important;
            color: #475569 !important;
            cursor: pointer;
            transition: all 0.15s ease;
            margin: 0 1px !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: #f1f5f9 !important;
            border-color: #94a3b8 !important;
            color: #1e293b !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.current,
        .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
            background: #1890ff !important;
            border-color: #1890ff !important;
            color: #ffffff !important;
            font-weight: 600 !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
            background: #f8fafc !important;
            border-color: #e2e8f0 !important;
            color: #cbd5e1 !important;
            cursor: not-allowed !important;
        }

        /* ==========================================================================
           Modern Date & Status Pill Badges
           ========================================================================== */
        .badge-date-overdue {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 11.5px;
            font-weight: 600;
            background-color: #fee2e2;
            color: #dc2626;
            border: 1px solid #fca5a5;
            white-space: nowrap;
        }

        .badge-date-overdue i {
            font-size: 10.5px;
        }

        .badge-date-nearly {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 11.5px;
            font-weight: 600;
            background-color: #fef3c7;
            color: #b45309;
            border: 1px solid #fcd34d;
            white-space: nowrap;
        }

        .badge-date-nearly i {
            font-size: 10.5px;
        }

        .badge-date-normal {
            display: inline-block;
            font-size: 12.5px;
            color: #334155;
            white-space: nowrap;
        }

        .badge-category {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 11.5px;
            font-weight: 500;
            background-color: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
            white-space: nowrap;
        }

        /* ==========================================================================
           Table Action Buttons (Unified UI)
           ========================================================================== */
        .table-action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            padding: 4px 10px;
            font-size: 12px;
            font-weight: 500;
            border-radius: 5px;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none !important;
            line-height: 1.4;
        }

        .table-action-btn.btn-edit {
            color: #0284c7;
            background-color: #e0f2fe;
            border-color: #bae6fd;
        }

        .table-action-btn.btn-edit:hover {
            color: #0369a1;
            background-color: #bae6fd;
            border-color: #7dd3fc;
        }

        .table-action-btn.btn-delete {
            color: #dc2626;
            background-color: #fee2e2;
            border-color: #fca5a5;
        }

        .table-action-btn.btn-delete:hover {
            color: #b91c1c;
            background-color: #fca5a5;
            border-color: #f87171;
        }

        .table-action-btn.btn-obsolete {
            color: #4f46e5;
            background-color: #e0e7ff;
            border-color: #c7d2fe;
        }

        .table-action-btn.btn-obsolete:hover {
            color: #3730a3;
            background-color: #c7d2fe;
            border-color: #a5b4fc;
        }

        .table-action-btn.btn-recover {
            color: #16a34a;
            background-color: #dcfce7;
            border-color: #bbf7d0;
        }

        .table-action-btn.btn-recover:hover {
            color: #15803d;
            background-color: #bbf7d0;
            border-color: #86efac;
        }

        .table-action-btn.btn-view {
            color: #1890ff;
            background-color: #e6f4ff;
            border-color: #bae0ff;
            padding: 4px 8px;
            border-radius: 4px;
        }

        .table-action-btn.btn-view:hover {
            color: #096dd9;
            background-color: #bae0ff;
        }

        /* ==========================================================================
           Tablet & Touch Screen Responsiveness Enhancements
           ========================================================================== */
        /* Table and form container */
        #TableForm,
        .table-responsive-custom {
            width: 100%;
        }

        /* Slim Scrollbar for DataTables on Touch Screens */
        .dataTables_wrapper::-webkit-scrollbar,
        #TableForm::-webkit-scrollbar {
            height: 6px;
        }

        .dataTables_wrapper::-webkit-scrollbar-thumb,
        #TableForm::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 3px;
        }

        .dataTables_wrapper::-webkit-scrollbar-track,
        #TableForm::-webkit-scrollbar-track {
            background-color: #f8fafc;
        }

        /* Dropdown touch active support */
        .navbar-links .dropdown.show > .dropdown-menu,
        .navbar-links .dropdown.open > .dropdown-menu,
        .navbar-links .dropdown-menu.show,
        .navbar-links .dropdown-menu.open {
            display: block !important;
        }

        .navbar-links .dropdown.show .dropdown-toggle .nav-chevron,
        .navbar-links .dropdown.open .dropdown-toggle .nav-chevron,
        .navbar-links .dropdown:hover .dropdown-toggle .nav-chevron {
            transform: rotate(180deg);
            color: #1890ff;
        }

        /* Tablet Breakpoint (Landscape & Portrait: max-width: 1200px) */
        @@media (max-width: 1200px) {
            .navbar {
                padding: 0 12px;
                height: 56px;
            }

            .navbar-logo {
                padding-right: 10px;
                margin-right: 8px;
                height: 32px;
            }

            .navbar-logo img {
                height: 30px;
            }

            /* Allow dropdown menus to overflow and pop down without being clipped on Tablet */
            .navbar-links {
                overflow: visible !important;
                white-space: nowrap;
                padding: 4px 0;
            }

            .navbar-links > li > a {
                padding: 6px 9px;
                font-size: 12px;
            }

            .navbar-actions {
                margin-left: 8px;
                gap: 6px;
            }

            .navbar-user-chip {
                padding: 4px 8px;
                font-size: 11px;
            }

            .btn-nav-signin,
            .btn-nav-signout {
                padding: 5px 10px;
                font-size: 11.5px;
            }
        }

        @@media (max-width: 992px) {
            .navbar {
                padding: 0 8px;
            }

            .navbar-links > li > a {
                padding: 5px 6px;
                font-size: 11px;
                gap: 3px;
            }

            .navbar-user-chip {
                max-width: 120px;
            }

            .navbar-user-chip #signin-name {
                max-width: 80px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }
        }

        /* Tablet & Mobile Touch Targets (max-width: 1024px) */
        @@media (max-width: 1024px) {
            .content {
                margin-top: 66px;
                padding: 0 12px;
            }

            /* Slightly larger touch targets for buttons on tablet */
            .table-action-btn {
                padding: 6px 12px !important;
                font-size: 12.5px !important;
                min-height: 32px !important;
            }

            .table-action-btn.btn-view {
                min-width: 32px !important;
                min-height: 32px !important;
                padding: 6px 10px !important;
                font-size: 13px !important;
            }

            /* Touch comfortable table row padding */
            table.dataTable tbody td {
                padding: 9px 10px !important;
            }

            /* Responsive filter inputs */
            .filter-card-header {
                padding: 10px 14px;
            }

            .filter-card-body {
                padding: 14px 14px 4px 14px;
            }

            .filter-card-footer {
                padding: 10px 14px;
            }

            .filter-card .form-control {
                height: 38px !important;
                font-size: 13px !important;
            }

            .btn-filter-search,
            .btn-filter-reset {
                height: 38px !important;
                padding: 0 18px !important;
            }
        }

        .form-control {
            border-radius: 6px;
            margin: 3px 0px;
            /*padding: 10px 10px;*/
            width: 100%;
            font-size: 12px;
            border: 1px solid #d9d9d9;
            outline: none;
            background-color: whitesmoke;
        }

        select.ant-select {
            width: 100%;
            padding: 8px 6px;
            margin: 3px 0px;
            border: 1px solid #d9d9d9;
            border-radius: 6px;
            background-color: whitesmoke;
            font-size: 12px;
            color: #595959;
            box-sizing: border-box;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            select.ant-select:focus {
                border-color: #40a9ff;
                outline: none;
                box-shadow: 0 0 0 2px rgba(24, 144, 255, 0.2);
            }

            select.ant-select option {
                padding: 8px;
                background-color: #fff;
                color: #000;
            }

                select.ant-select option:hover {
                    background-color: #f0f0f0;
                }

            select.ant-select:disabled {
                background-color: #f5f5f5;
                border-color: #d9d9d9;
                color: #bfbfbf;
            }

        .select2-container--default .select2-selection--single {
            background-color: whitesmoke;
            border: 1px solid #ccc;
        }
        /* The container */
        .container {
            display: block;
            width: 100%;
            position: relative;
            padding-left: 35px;
            margin-bottom: 12px;
            cursor: pointer;
            font-size: 12px;
            font-weight: normal;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }

            /* Hide the browser's default radio button */
            .container input {
                position: absolute;
                opacity: 0;
                cursor: pointer;
            }

        /* Create a custom radio button */
        .checkmark {
            position: absolute;
            top: 0;
            left: 0;
            height: 20px;
            width: 20px;
            background-color: #eee;
            border-radius: 50%;
        }

        /* On mouse-over, add a grey background color */
        .container:hover input ~ .checkmark {
            background-color: #ccc;
        }

        /* When the radio button is checked, add a blue background */
        .container input:checked ~ .checkmark {
            background-color: #1890ff;
        }

        /* Create the indicator (the dot/circle - hidden when not checked) */
        .checkmark:after {
            content: "";
            position: absolute;
            display: none;
        }

        /* Show the indicator (dot/circle) when checked */
        .container input:checked ~ .checkmark:after {
            display: block;
        }

        /* Style the indicator (dot/circle) */
        .container .checkmark:after {
            top: 6px;
            left: 6px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: white;
        }

