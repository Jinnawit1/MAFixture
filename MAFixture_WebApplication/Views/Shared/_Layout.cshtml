                <ul class="dropdown-menu">
                    <li><a href="@Url.Action("Customer", "Global")">Customer</a></li>
                    <li><a href="@Url.Action("EmailList", "Global")">Email List</a></li>
                    <li><a href="@Url.Action("MasterMAList", "Global")">MasterMA List</a></li>
                    <li><a href="@Url.Action("PinList", "Global")">PIN List</a></li>
                    @*<li><a href="@Url.Action("MachineList", "Global")">Machine List</a></li>*@
                    <!-- Add more submenu items as needed -->
