<script type="text/javascript">
    var isLocal = (location.hostname === "localhost" || location.hostname === "127.0.0.1");

    var basePath = isLocal
        ? "/Equipment_Picture/"
        : "/MATesting/Equipment_Picture/";
    const url = new URL(window.location.href);
    const path = url.pathname;
    $(document).ready(function () {

        console.log(path);
        if (
            url.searchParams.has('username') &&
            url.searchParams.has('password')
        ) {
            const username = url.searchParams.get('username');
            const password = url.searchParams.get('password');
            Login(username, password);
        }
        $('input').attr('readonly', true).on('mouseover', function () {
            $(this).removeAttr('readonly');
        });
        $('input').attr('readonly', true).on('focus', function () {
            $(this).removeAttr('readonly');
        });
        // เรียก CheckCookieLoad() เฉพาะถ้าไม่ใช่ Report_Analysis
        if (path.includes("Report_Analysis") || path.includes("THT_Location") || path.includes("Summary_THT_Pallet")) {
            $("#signin-text").hide();
            $("#user-profile-badge").hide();
        }
        else {
            CheckCookieLoad();
            $("#signin-text").show();
        }

        // Highlight active navbar menu based on current route
        setActiveNavbarMenu();

        // Touch screen & click support for navbar dropdowns on Tablet & Mobile
        $('.navbar-links .dropdown > a').on('click', function (e) {
            e.preventDefault();
            e.stopPropagation();

            var $parent = $(this).closest('.dropdown');
            var isOpen = $parent.hasClass('show') || $parent.hasClass('open');

            // Close all open dropdowns
            $('.navbar-links .dropdown').removeClass('show open');
            $('.navbar-links .dropdown-menu').removeClass('show open');
            $('.dropdown-backdrop').remove();

            // Toggle current dropdown
            if (!isOpen) {
                $parent.addClass('show open');
                $parent.find('> .dropdown-menu').addClass('show open');
            }
        });

        // Close dropdown when tapping anywhere outside
        $(document).on('click touchstart', function (e) {
            if (!$(e.target).closest('.navbar-links .dropdown').length) {
                $('.navbar-links .dropdown').removeClass('show open');
                $('.navbar-links .dropdown-menu').removeClass('show open');
                $('.dropdown-backdrop').remove();
            }
        });

        // Prevent dropdown from closing prematurely when clicking inside the dropdown menu (except links)
        $('.navbar-links .dropdown-menu').on('click touchstart', function (e) {
            e.stopPropagation();
        });
    });
    $('#logout').click(function () { delCookie(); });

    $('#SubmitLogin').click(function () { Login(); });
    $(document).keydown(function (e) {
        if (e.which === 13 && $("#SubmitLogin").is(":visible")) {
            $("#SubmitLogin").click();
        }
    });
    $('#myModalLogIn').on('shown.bs.modal', function () {
        document.getElementById("UserName").focus();
    });

    $('#myModalLogIn').on('hidden.bs.modal', function () {
        //ClearTextBox();
        CheckCookieLoad();
    });

    $('.btnLoading').on('click', function () {
        var $btn = $(this).button('loading');

        setTimeout(function Call() {
            $btn.button('reset');
        }, 3000);

    });
    let lastScrollTop = 0; // Variable to keep track of last scroll position

    window.addEventListener('scroll', function () {
        let navbar = document.querySelector('.navbar'); // Select the navbar element
        let currentScroll = window.pageYOffset || document.documentElement.scrollTop;

        if (currentScroll > lastScrollTop) {
            // If scrolling down, hide the navbar
            navbar.style.top = "-70px"; // Adjust this value to match your navbar height
        } else {
            // If scrolling up, show the navbar
            navbar.style.top = "0";
        }

        lastScrollTop = currentScroll <= 0 ? 0 : currentScroll; // Prevent negative scroll position
    });


    function getFormLogIn() {
        var Login = $("#Login").val();
        var password = $("#Password").val();
        return { Login: Login, Password: password };
    }

    function Login(username, password) {
        var datajson = JSON.stringify(getFormLogIn());
        if (username && password) {
            datajson = JSON.stringify({ Login: username, Password: password });
        }
        var url = '@Url.Action("LogIn", "Global")';
        $.ajax({
            type: 'Post',
            url: url,
            data: datajson,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                if (response.success) {
                    if (username && password) {
                        const url = new URL(window.location.href);
                        url.searchParams.delete('username');
                        url.searchParams.delete('password');
                        window.history.replaceState(null, '', url.toString());
                    }
                    CheckCookieLoad();
                    location.reload();
                }
                else { $('#StatusLogin').html('<div style="color:red"><i class="fas fa-times-circle"></i> Incorrect UserName Or Password</span></div>'); }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

    function handleAuthButtonClick() {
        var $btn = $("#signin-text");
        if ($btn.hasClass("btn-nav-signout")) {
            delCookie();
        } else {
            $("#myModalLogIn").modal("show");
        }
    }

    function delCookie() {
        interuptAjax = $.ajax({
            type: "POST", data: JSON.stringify(), url: "@Url.Action("DelCookie", "Global")", async: true,
            success: function (datares) {
                document.location = '@Url.Action("Index", "Global")';
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

    function CheckCookieLoad() {
        var datajson = JSON.stringify();

        var url = "@Url.Action("GetCookie", "Global")";
        $.ajax({
            type: 'Post',
            url: url,
            data: datajson,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (response) {
                var $btn = $("#signin-text");
                var $badge = $("#user-profile-badge");
                var $name = $("#signin-name");

                if (response.success) {
                    $name.text(response.data);
                    $badge.css('display', 'inline-flex');
                    $btn.removeClass("btn-nav-signin")
                        .addClass("btn-nav-signout")
                        .html('<i class="fas fa-sign-out-alt"></i> <span>Sign Out</span>');
                }
                else {
                    $name.text("");
                    $badge.hide();
                    $btn.removeClass("btn-nav-signout")
                        .addClass("btn-nav-signin")
                        .html('<i class="fas fa-sign-in-alt"></i> <span>Sign In</span>');

                    $("#myModalLogIn").modal("show");
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                showAlert('error', 'An error occurred. Please try again later. Details: ' + textStatus + ', ' + errorThrown, function () { });
            }
        });
    }

    function setActiveNavbarMenu() {
        var currentPath = window.location.pathname.toLowerCase();
        var bestMatch = null;
        var maxMatchLength = 0;

        $('.navbar-links a').removeClass('active');
        $('.navbar-links .dropdown').removeClass('active');

        $('.navbar-links a').each(function () {
            var href = $(this).attr('href');
            if (href && href !== '#' && href.indexOf('javascript') === -1) {
                var linkPath = href.toLowerCase().split('?')[0];
                if (linkPath.length > 1 && (currentPath === linkPath || currentPath.indexOf(linkPath) !== -1)) {
                    if (linkPath.length > maxMatchLength) {
                        bestMatch = $(this);
                        maxMatchLength = linkPath.length;
                    }
                }
            }
        });

        if (bestMatch) {
            bestMatch.addClass('active');
            var parentDropdown = bestMatch.closest('.dropdown');
            if (parentDropdown.length > 0) {
                parentDropdown.addClass('active');
                parentDropdown.find('> a.dropdown-toggle').addClass('active');
            }
        } else {
            if (currentPath === '/' || currentPath.indexOf('/index') !== -1 || (currentPath.indexOf('/global') !== -1 && currentPath.indexOf('history') === -1 && currentPath.indexOf('equipment') === -1 && currentPath.indexOf('maintenance') === -1 && currentPath.indexOf('obsolete') === -1 && currentPath.indexOf('report') === -1 && currentPath.indexOf('location') === -1 && currentPath.indexOf('pallet') === -1 && currentPath.indexOf('list') === -1 && currentPath.indexOf('customer') === -1)) {
                $('.navbar-links a[href*="Index"]').addClass('active');
            }
        }
    }

    function confirm(message, onConfirm, onCancel) {
        confirmMessage.innerText = message;

        confirmModal.style.display = 'flex';

        // Handle the confirm button click
        confirmButton.onclick = function () {
            confirmModal.style.display = 'none'; // Hide modal
            if (onConfirm) onConfirm();  // Call the onConfirm callback
        };

        // Handle the cancel button click
        cancelButton.onclick = function () {
            confirmModal.style.display = 'none'; // Hide modal
            if (onCancel) onCancel();  // Call the onCancel callback (if provided)
        };

        // Close the modal if the user clicks outside of it
        window.onclick = function (event) {
            if (event.target === confirmModal) {
                confirmModal.style.display = 'none';
                if (onCancel) onCancel();
            }
        };
    }

    var alertTimer = null;

    function showAlert(type, message, callback) {
        // หากไม่ใช่ success ให้แปลงเป็น error ทั้งหมดตามที่กำหนด
        if (type !== "success") {
            type = "error";
        }

        var text = message;
        if (text === null || text === undefined || text === "") {
            text = (type === "success") ? "Operation completed successfully." : "An error occurred. Please try again.";
        }

        // ซ่อน Alert ทุกตัวที่ค้างอยู่
        $(".alert").removeClass("show").hide();

        // ล้าง Timer เดิม ป้องกันปัญหาซ้อนทับกัน
        if (alertTimer) {
            clearTimeout(alertTimer);
            alertTimer = null;
        }

        var $alert = $("#alert-" + type);
        var $alertText = $("#alert-" + type + "-text");

        if ($alert.length > 0) {
            $alertText.text(text);
            $alert.css("display", "flex").addClass("show");

            alertTimer = setTimeout(function () {
                $alert.removeClass("show").hide();
                alertTimer = null;
                if (callback && typeof callback === "function") {
                    callback();
                }
            }, 3500);
        }
    }
    function Dateformat(date) {
        return date.getFullYear() + '-' +
               String(date.getMonth() + 1).padStart(2, '0') + '-' +
               String(date.getDate()).padStart(2, '0') + ' ' +
               String(date.getHours()).padStart(2, '0') + ':' +
               String(date.getMinutes()).padStart(2, '0') + ':' +
               String(date.getSeconds()).padStart(2, '0');
    }

    function addDays(date, days) {
        let result = new Date(date);
        result.setDate(result.getDate() + days);
        return result;
    }

    function formatDate(item, option) {
        if (item) {
            var date;
            if (typeof item === 'string' && item.indexOf('/Date(') !== -1) {
                var timestamp = parseInt(item.replace(/[^0-9]/g, ''), 10);
                date = new Date(timestamp);
            } else {
                date = new Date(item);
            }

            if (isNaN(date.getTime())) return '';

            // Format the date and time
            var formattedDate = date.format('yyyy-mm-dd');
            var formattedTime = date.format('HH:MM:ss');

            // Combine the date and time with a <br> separator
            if (option == 1) {
                return formattedDate + ' ' + formattedTime;
            } else if (option == 2) {
                return formattedDate;
            } else if (option == 3) {
                return formattedTime;
            }
        }
        return '';
    }

    function toggleCodeReader(codeReader, selectedDeviceId) {
        var videoDiv = document.getElementById('video-col-custom');
        if (!videoStatus) {
            videoDiv.style.display = 'block';
            codeReader.decodeFromVideoDevice(selectedDeviceId, 'video', function (result, err) {
                if (result) {
                    document.getElementById('Serial_No_Input').value = result.text;

                    document.getElementById('video-message').textContent = "Success! Barcode detected.";
                    document.getElementById('video-message').style.backgroundColor = '#f6ffed';
                    document.getElementById('video-message').style.borderColor = '#b7eb8f';

                    var event = new KeyboardEvent('keydown', {
                        key: 'Enter', // The key that was pressed
                        code: 'Enter', // The code for the Enter key
                        keyCode: 13, // The keycode for Enter key (13)
                        which: 13, // The which value for Enter key (13)
                        bubbles: true, // Make the event bubble up the DOM
                        cancelable: true // Allow the event to be canceled
                    });

                    // Dispatch the event on the input field
                    document.getElementById('Serial_No_Input').dispatchEvent(event);
                }
                if (err && !(err instanceof ZXing.NotFoundException)) {
                    showAlert('error', err, function () { });
                }
            });
        } else {
            codeReader.reset();
            videoDiv.style.display = 'none';
        }
    }

    function toggleVideo() {
        var videoIcon = document.getElementById('video-icon');
        if (videoStatus) {
            if (videoInputDevicesStatus) {
                videoIcon.classList.remove("fa-video-slash");
                videoIcon.classList.add("fa-video");
                document.getElementById('video').style.display = "block";
                videoStatus = false;
            } else showAlert('error', "Camera not found.", function () { });
        } else {
            videoIcon.classList.remove("fa-video");
            videoIcon.classList.add("fa-video-slash");
            document.getElementById('video').style.display = "none";
            videoStatus = true;
        }
    }

    function formatDateToSave(data) {
        if (data != null) {
            for (var key in data) {
                if (data.hasOwnProperty(key) &&
                    (key.toLowerCase().includes('date') || key.toLowerCase().includes('plan_'))
                ) {
                    var rawValue = data[key];
                    if (rawValue) {
                        var dateObj = null;

                        // Case: "/Date(1754298922000)/"
                        if (typeof rawValue === 'string' && rawValue.indexOf('/Date') !== -1) {
                            var timestamp = parseInt(rawValue.replace(/[^0-9]/g, ''), 10);
                            if (!isNaN(timestamp)) {
                                dateObj = new Date(timestamp);
                            }
                        } else {
                            dateObj = new Date(rawValue);
                        }

                        // Validate date
                        if (dateObj && !isNaN(dateObj.getTime())) {
                            var yyyy = dateObj.getFullYear();
                            var mm = ('0' + (dateObj.getMonth() + 1)).slice(-2);
                            var dd = ('0' + dateObj.getDate()).slice(-2);
                            var HH = ('0' + dateObj.getHours()).slice(-2);
                            var MM = ('0' + dateObj.getMinutes()).slice(-2);
                            var ss = ('0' + dateObj.getSeconds()).slice(-2);

                            data[key] = yyyy + '-' + mm + '-' + dd + ' ' + HH + ':' + MM + ':' + ss;
                        } else {
                            console.warn("Invalid date for key:", key, rawValue);
                        }
                    }
                }
            }
        }

        return data;
    }
    function highlightDate(data, daysRange) {
        if (!data) return "";

        // ป้องกัน timezone offset และความคลาดเคลื่อนของเวลา ด้วยการเทียบวันแบบ local midnight
        var parts = data.split(' ')[0].split('-');
        var year, month, day;
        if (parts.length === 3) {
            year = parseInt(parts[0], 10);
            month = parseInt(parts[1], 10) - 1;
            day = parseInt(parts[2], 10);
        } else {
            var d = new Date(data);
            if (isNaN(d.getTime())) return data;
            year = d.getFullYear();
            month = d.getMonth();
            day = d.getDate();
        }

        var date = new Date(year, month, day);
        if (isNaN(date.getTime())) return data;

        var now = new Date();
        var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

        var limitDate = new Date(today);
        limitDate.setDate(today.getDate() + (daysRange || 0));

        var diffTime = date - today;
        var diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));

        if (date < today) {
            // เลยกำหนด (Overdue)
            var overdueText = Math.abs(diffDays) === 1 ? '1 day ago' : Math.abs(diffDays) + ' days ago';
            return '<span class="badge-date-overdue" title="Overdue (' + overdueText + ')"><i class="fas fa-exclamation-circle"></i> ' + data + '</span>';
        } else if (daysRange && date >= today && date <= limitDate) {
            // ใกล้ถึงกำหนด (Nearly Due)
            var dayLabel = diffDays === 0 ? 'Today' : (diffDays === 1 ? '1 day left' : diffDays + ' days left');
            return '<span class="badge-date-nearly" title="Due in ' + diffDays + ' days"><i class="fas fa-clock"></i> ' + data + ' <small>(' + dayLabel + ')</small></span>';
        } else {
            // แผนกำหนดการปกติ
            return '<span class="badge-date-normal">' + data + '</span>';
        }
    }

</script>
